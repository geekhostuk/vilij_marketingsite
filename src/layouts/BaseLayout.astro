---
// The Vilij — the shared page shell: the document head, and the scripts that
// close the body. Everything that legitimately varies between pages is a prop.
//
// The page's own markup is passed as the default slot and must start with the
// full-width wrapper <div>; that div stays in the pages because Astro strips
// HTML comments that sit at the top level of slotted content, and the pages'
// <!-- ===== SECTION ===== --> markers need to survive.
//
// Each page also keeps its own <style is:global> block, which Astro lifts into
// this head for us. The comment here used to say the three variants interleave
// and so could not share a base; that is no longer true — the six content
// pages' blocks are byte-identical to each other, and so are the six legal
// pages'. Consolidating them is still worth doing (ISSUES #22) but it would
// churn all 13 pages, so it is not part of the responsive work.
// The pages butt </style> straight up against the wrapper <div> for the same
// reason the slot below has no whitespace around it: Astro's HTML compressor
// works per component, so a newline on both sides of a boundary becomes two
// spaces in the output rather than one.
//
// responsive.css is the site's one real stylesheet: the tablet and mobile
// layer, ISSUES #20. Every rule in it sits inside a max-width media query, so
// importing it here cannot move the desktop design on any of the 13 pages.
// Read its header before changing any inline font-size anywhere on the site.
import "../styles/responsive.css";
import TestimonialScript from "../components/TestimonialScript.astro";
import ToTopScript from "../components/ToTopScript.astro";
import CookieConsent from "../components/CookieConsent.astro";
import type { Testimonial } from "../data/testimonials";

interface Props {
  title: string;
  description: string;
  // Keeps /newsletter-thanks out of the index.
  noindex?: boolean;
  // Extra Google Fonts families, spliced into the stylesheet URL. /hall adds Caveat.
  extraFonts?: string;
  // The testimonials this page rotates through, if it has a carousel. Pages
  // without one get the standalone "back to the top" handler instead.
  carousel?: Testimonial[];
}

const { title, description, noindex = false, extraFonts = "", carousel } = Astro.props;

// Body copy is Lato (Damien, 30 Jul 2026). Headings are still Quicksand pending
// his answer on one open question: the Illustrator sources pair Figtree Medium
// with Lato, so "Lato throughout" may or may not mean the headings too. Body is
// Lato under either answer, which is why only half the swap has happened.
//
// Only 400 and 700 are requested. Lato has no 500, 600 or 800 — the weights the
// old Mulish declarations used — so every one of those was rewritten to an
// explicit 700 rather than left for the browser to round silently. Add 300 or
// 900 here if a real use for them appears; do not add 500/600/800, they do not
// exist and Google Fonts will ignore them.
const fontHref =
  "https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Lato:wght@400;700" +
  extraFonts +
  "&display=swap";

// C50 — canonical URL, derived from `site` in astro.config.mjs and this page's
// own path. Astro builds to /cafe/index.html and Cloudflare Pages serves that at
// /cafe, redirecting /cafe/ to it, so the canonical drops the trailing slash on
// everything except the homepage. That matches public/sitemap.xml and every
// internal link on the site: a canonical pointing at a URL that redirects is
// worse than no canonical at all.
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonical = new URL(path || "/", Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title set:html={title}></title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
  </head>
  <body><slot />{carousel ? <TestimonialScript list={carousel} /> : <ToTopScript />}
    <!--
      The HubSpot tracking script used to be a plain <script> tag here, and it
      set four analytics cookies on every visitor before anyone had agreed to
      anything (C58). It is now injected by CookieConsent, and only once someone
      has accepted. Do not put it back: an unconditional tag is the whole bug.
    -->
    <CookieConsent />
  </body>
</html>
