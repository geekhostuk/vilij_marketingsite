---
// The Vilij — the shared page shell: the document head, and the scripts that
// close the body. Everything that legitimately varies between pages is a prop.
//
// The page's own markup is passed as the default slot and must start with the
// full-width wrapper <div>; that div stays in the pages because Astro strips
// HTML comments that sit at the top level of slotted content, and the pages'
// <!-- ===== SECTION ===== --> markers need to survive.
//
// Each page also keeps its own <style is:global> block, which Astro lifts into
// this head for us. The comment here used to say the three variants interleave
// and so could not share a base; that is no longer true — the six content
// pages' blocks are byte-identical to each other, and so are the six legal
// pages'. Consolidating them is still worth doing (ISSUES #22) but it would
// churn all 13 pages, so it is not part of the responsive work.
// The pages butt </style> straight up against the wrapper <div> for the same
// reason the slot below has no whitespace around it: Astro's HTML compressor
// works per component, so a newline on both sides of a boundary becomes two
// spaces in the output rather than one.
//
// cards.css is the feature-card geometry: the "imaginary outer shape" the
// designs are built on, and the intrinsic-width unlock that used to be patched
// three separate ways. It is the one stylesheet that does move the desktop
// design, deliberately — read its header before touching a card.
import "../styles/cards.css";
// responsive.css is the site's other stylesheet: the tablet and mobile layer,
// ISSUES #20. Every rule in it sits inside a max-width media query, so
// importing it here cannot move the desktop design on any of the 13 pages. It
// comes second so its !important rules win over cards.css at narrow widths.
// Read its header before changing any inline font-size anywhere on the site.
import "../styles/responsive.css";
import TestimonialScript from "../components/TestimonialScript.astro";
import ToTopScript from "../components/ToTopScript.astro";
import CookieConsent from "../components/CookieConsent.astro";
import type { Testimonial } from "../data/testimonials";

interface Props {
  title: string;
  description: string;
  // Keeps /newsletter-thanks, /library and /wellbeing out of the index.
  noindex?: boolean;
  // C50 / SEO-REVIEW §4 — the Open Graph share image, root-relative. Defaults to
  // the site-wide card; give a page its own by passing this. Whatever it points
  // at must be 1200x630, or the og:image:width/height below become a lie and
  // Facebook and LinkedIn will letterbox the result.
  ogImage?: string;
  // Alt text for that image. Defaults with it, so a page that overrides one
  // should override both.
  ogImageAlt?: string;
  // Extra Google Fonts families, spliced into the stylesheet URL. /hall adds Caveat.
  extraFonts?: string;
  // The testimonials this page rotates through, if it has a carousel. Pages
  // without one get the standalone "back to the top" handler instead.
  carousel?: Testimonial[];
}

const {
  title,
  description,
  noindex = false,
  extraFonts = "",
  carousel,
  ogImage = "/assets/og-default.jpg",
  ogImageAlt = "An illustration of The Vilij village",
} = Astro.props;

// Lato throughout, headings included (Damien, 31 Jul 2026: "It's always been
// Lato"). This closes the Figtree question — the Illustrator sources pair
// Figtree Medium with Lato, and the web build had substituted Quicksand for the
// headings while that was open.
//
// Two weights, and the tiers are deliberate:
//
//   700  everything structural — the 74px h1, the 58px band h2 and the 50px
//        section h2, and equally the 40px card h3, footer, pills, nav and table
//        headers. Hierarchy above 50px is carried by SIZE ALONE, on purpose.
//   400  the strapline voice: the 36px band paragraph and the 34px "Still not
//        sure?". These are the one place the old "round 500 up to 700"
//        precedent must not be applied — they sit directly under a heading, and
//        at 700 they read as a second heading and flatten the hierarchy.
//
// The display tier was 900 (Black) until 31 July 2026. Damien: "I think the big
// headings can go back to bold instead of black — there is enough size
// difference to differentiate the two. Black is a bit too strong for the subject
// matter." That last clause is the reason and it outranks the typographic
// argument that put 900 there: a 74px Black headline shouts, and the page is
// addressed to exhausted parents. Do not reintroduce 900 for weight-versus-size
// reasons without asking Damien first.
//
// So the font request below asks for 400 and 700 only. Lato ships
// 100/300/400/700/900 and nothing else. Do not add 500, 600 or 800: Google Fonts
// ignores them and the browser rounds silently, which is how the emphasis ladder
// collapses without anyone noticing.
//
// Sizes were not touched. src/styles/responsive.css steps type down by matching
// the literal inline string, so weight is free to change and px is not.
const fontHref =
  "https://fonts.googleapis.com/css2?family=Lato:wght@400;700" +
  extraFonts +
  "&display=swap";

// C50 — canonical URL, derived from `site` in astro.config.mjs and this page's
// own path.
//
// This used to strip the trailing slash, on the stated grounds that Cloudflare
// Pages serves /cafe and redirects /cafe/ to it. That was backwards, and it was
// never true. Measured against production on 31 Jul 2026:
//
//   GET /cafe   ->  308 Permanent Redirect  ->  /cafe/
//   GET /cafe/  ->  200 OK
//
// Astro's default build format is `directory`, so every route builds to
// <route>/index.html, and Cloudflare canonicalises those to the trailing-slash
// form. So the slash-less canonical pointed at a URL that redirects on all 12
// indexable routes — precisely the thing the old comment said it was avoiding.
//
// The trailing slash is therefore the real URL and the canonical says so.
// public/sitemap.xml matches. If Astro's `build.format` or `trailingSlash` is
// ever changed, re-measure with `curl -I` before touching this: the correct
// answer is whichever form returns 200, not whichever form looks tidier.
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonical = new URL(path ? `${path}/` : "/", Astro.site).href;

// SEO-REVIEW §4 — Open Graph and Twitter Card. Both must be absolute URLs on the
// live origin; every scraper rejects a root-relative og:image, which is the
// usual reason a share silently renders with no picture.
const ogImageUrl = new URL(ogImage, Astro.site).href;

// og:site_name already carries the brand, so the "| The Vilij" suffix that every
// page title ends with is repetition inside a share card that has limited room.
// The homepage title uses an em dash rather than the pipe and so is untouched,
// which is correct — it reads as a sentence.
const ogTitle = title.replace(/\s*\|\s*The Vilij\s*$/, "");
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title set:html={title}></title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Vilij" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontHref} rel="stylesheet" />
  </head>
  <body><slot />{carousel ? <TestimonialScript list={carousel} /> : <ToTopScript />}
    <!--
      The HubSpot tracking script used to be a plain <script> tag here, and it
      set four analytics cookies on every visitor before anyone had agreed to
      anything (C58). It is now injected by CookieConsent, and only once someone
      has accepted. Do not put it back: an unconditional tag is the whole bug.
    -->
    <CookieConsent />
  </body>
</html>
