---
// The Vilij — the "Join The Vilij For £10/Month" pill with its two reassurance
// ticks underneath. The homepage uses it four times: the hero, the membership
// card, the "Why now?" section and the closing band.
//
// `tone` is what it sits on. "light" is an orange pill for white or pale
// backgrounds; "onOrange" is a white pill with white tick labels, for the
// orange bands, where an orange pill would disappear.
//
// Plain sign-up link, no tag — see 271132f.
interface Props {
  tone?: "light" | "onOrange";
  align?: "start" | "center";
  price?: string;
}
const { tone = "light", align = "start", price = "£10" } = Astro.props;
const onOrange = tone === "onOrange";
const pill = onOrange
  ? "background:#ffffff;color:#f28121;box-shadow:0 10px 24px rgba(0,0,0,0.12);"
  : "background:#f28121;color:#ffffff;box-shadow:0 10px 24px rgba(242,129,33,0.3);";
const tickText = onOrange ? "#ffffff" : "#353535";
---
<div class="vjoin" style={`display:flex;flex-direction:column;align-items:${align === "center" ? "center" : "flex-start"};gap:16px;`}>
  <a href="https://app.thevilij.co.uk/sign-up" class="vpill" style={`display:inline-flex;align-items:center;gap:16px;${pill}font-family:Lato;font-weight:700;font-size:20px;padding:12px 12px 12px 30px;border-radius:34px;text-decoration:none;`}>Join The Vilij For {price}/Month <span aria-hidden="true" style="width:40px;height:40px;flex:none;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
  <ul style="list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px 26px;">
    {["Cancel anytime", "Instant Access"].map((t) => (
      <li style={`display:flex;align-items:center;gap:8px;font-family:Lato;font-size:18px;color:${tickText};`}><span aria-hidden="true" style="width:22px;height:22px;flex:none;border-radius:50%;background:#1f9ca0;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;">&#10003;</span>{t}</li>
    ))}
  </ul>
</div>
