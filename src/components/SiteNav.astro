---
// The Vilij — site header navigation. Identical on all thirteen pages.
// The surrounding <section> is not here: its background gradient is page
// specific, so each page keeps its own header section wrapper.
//
// SIGN UP points at the app. Deliberately no target="_blank": app.thevilij.co.uk
// is the same brand, not an outbound link, so it opens in the same tab.
//
// ISSUES #20 — below 900px the three text links move into a dropdown panel
// behind a burger button. The logo and SIGN UP stay in the bar at every width:
// SIGN UP is the conversion action on a page aimed at people with very little
// spare attention, and it should never be a tap away behind a menu.
//
// The links are rendered twice, once in the bar and once in the panel, and
// exactly one copy is ever live — the bar copies are display:none below 900px
// and the panel is [hidden] above it, so neither the tab order nor the
// accessibility tree ever contains both. The array is the single source of
// truth so the two copies cannot drift apart.
//
// The panel is an in-flow dropdown under the bar rather than a full-screen
// overlay. That means no scroll lock, no focus trap, and no chance of ending
// up underneath the fixed cookie banner (z-index 9999).
//
// Sizing, hiding and the burger itself all live in src/styles/responsive.css.
//
// All three weights are 700. Home used to be 700 and the other two 600, a
// subtle cue that Lato cannot express — it ships 100/300/400/700/900 and has no
// 600. Dropping the other two to 400 was the alternative and it is worse: 400
// at 18px teal reads as body copy, so all three links would weaken to make one
// stand out. The `weight` field is now redundant but stays, because the array
// feeds both the desktop bar and the mobile panel and is the one place to
// change if a real distinction is wanted later.
const links = [
  { href: "/", label: "Home", weight: 700 },
  { href: "#", label: "Explore The Vilij", weight: 700 },
  { href: "#", label: "About Us", weight: 700 },
];
---
<div class="vnav-shell">
  <nav style="display:flex;align-items:center;justify-content:space-between;">
    <a href="/" class="vnav-logo"><img src="/assets/logo.png" alt="The Vilij" style="height:62px;width:auto;display:block;" /></a>
    <div class="vnav-right" style="display:flex;align-items:center;gap:42px;">
      {/* The trailing {" "} keeps the whitespace the hand-written links used to
          have between them. Flex ignores whitespace-only text nodes, so it
          changes nothing — but it keeps the built markup byte-identical to what
          shipped before, which makes "the desktop design did not move" a thing
          you can diff rather than a thing you have to take on trust. */}
      {links.map((l) => (
        <a href={l.href} class="vnav-link vlink" style={`font-family:Lato;font-weight:${l.weight};font-size:18px;color:#1f9ca0;text-decoration:none;`}>{l.label}</a>
      )).flatMap((el) => [el, " "])}
      <a href="https://app.thevilij.co.uk" class="vnav-cta vpill" style="font-family:Lato;font-weight:700;font-size:16px;letter-spacing:.5px;color:#ffffff;background:#1f9ca0;padding:13px 30px;border-radius:30px;text-decoration:none;box-shadow:0 6px 16px rgba(31,156,160,0.3);">SIGN UP</a>
      <button type="button" id="vnav-toggle" class="vnav-burger" aria-expanded="false" aria-controls="vnav-panel" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div id="vnav-panel" class="vnav-panel" hidden>
    {links.map((l) => <a href={l.href} class="vlink">{l.label}</a>)}
  </div>
</div>
<script>
  (function () {
    const toggle = document.getElementById("vnav-toggle");
    const panel = document.getElementById("vnav-panel");
    if (!toggle || !panel) return;

    function setOpen(open: boolean) {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    }

    function close(refocus: boolean) {
      if (panel.hidden) return;
      setOpen(false);
      if (refocus) toggle.focus();
    }

    toggle.addEventListener("click", () => setOpen(panel.hidden));

    // Escape returns focus to the button; a click elsewhere does not, because
    // the pointer has already moved the user's attention somewhere else.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close(true);
    });

    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!panel.contains(t) && !toggle.contains(t)) close(false);
    });

    // Following a link inside the panel navigates on this same page for the
    // two "#" placeholders, which would otherwise leave the panel open.
    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) close(false);
    });

    // Crossing back above the breakpoint hides the panel by CSS, so close it
    // properly rather than leaving aria-expanded="true" on an invisible menu.
    const wide = window.matchMedia("(min-width: 901px)");
    wide.addEventListener("change", (e) => {
      if (e.matches) close(false);
    });
  })();
</script>
