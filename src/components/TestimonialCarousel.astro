---
// The Vilij — the testimonial carousel, shown on the homepage and the five
// content pages. The rotation itself is driven by TestimonialScript.astro, which
// BaseLayout renders at the end of the body.
//
// `showQuoteMark` is the decorative teal speech-mark bubble over the photo.
// It is on every page except /cafe, which lost it at some point — see the drift
// list in content-issues.md.
//
// C51 — the star row is an image with an accessible name taken from the rating,
// and the ★ glyphs themselves are hidden from assistive technology. A slot with
// no rating (stars: null) carries neither role nor label and stays display:none,
// so it announces nothing at all.
//
// C3 — with showSecondTestimonial off the list has a single entry, and a
// carousel of one is not a carousel. The prev/next controls are not rendered at
// all in that case rather than disabled or hidden with CSS: there is nothing to
// page to, so there should be nothing to tab to either. The role line drops its
// bottom margin at the same time so the column does not end in dead space.
// (There are no dot indicators on this carousel — the controls are the only nav.)
import type { Testimonial } from "../data/testimonials";

interface Props {
  list: Testimonial[];
  showQuoteMark?: boolean;
}
const { list, showQuoteMark = true } = Astro.props;
const first = list[0];
const hasNav = list.length > 1;
---
<section style="background:#ffffff;padding:74px 0 80px;">
  <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
    <p style="font-family:Lato;font-weight:700;font-size:23px;color:#353535;text-align:center;margin:0 0 6px;">Our Testimonials</p>
    <h2 style="font-family:Quicksand;font-weight:700;font-size:50px;color:#1f9ca0;text-align:center;margin:0 0 56px;">What Our <span style="color:#f28121;">Vilijers</span> Say</h2>
    <div class="vtestim" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:64px;align-items:center;">
      {showQuoteMark ? (
        <div class="vtestim-photo" style="position:relative;">
          <img id="t-photo" src={first.photo} alt="A SEND family" style="width:100%;height:auto;border-radius:18px;display:block;box-shadow:0 14px 34px rgba(0,0,0,0.14);" />
          <div class="vquote-mark" style="position:absolute;top:-22px;right:-22px;width:84px;height:84px;border-radius:50%;background:#1f9ca0;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 18px rgba(31,156,160,0.35);">
            <span style="font-family:Georgia,serif;font-weight:700;font-size:58px;line-height:1;color:#fff;margin-top:30px;">&rdquo;</span>
          </div>
        </div>
      ) : (
        <div class="vtestim-photo" style="position:relative;">
          <img id="t-photo" src={first.photo} alt="A SEND family" style="width:100%;height:auto;border-radius:18px;display:block;box-shadow:0 14px 34px rgba(0,0,0,0.14);" />
        </div>
      )}
      <div>
        <div id="t-stars" role={first.stars ? "img" : undefined} aria-label={first.stars ? `Rated ${first.stars} out of 5` : undefined} style={`color:#f28121;font-size:28px;letter-spacing:6px;margin-bottom:18px;${first.stars ? "" : "display:none;"}`}><span id="t-star-glyphs" aria-hidden="true">{first.stars ? "★".repeat(first.stars) : ""}</span></div>
        <p id="t-quote" style="font-family:Lato;font-size:21px;line-height:1.6;color:#5a5a5a;margin:0 0 28px;max-width:560px;">{first.quote}</p>
        <p id="t-name" style="font-family:Lato;font-weight:700;font-size:24px;color:#222;margin:0 0 4px;">{first.name}</p>
        <p id="t-role" style={`font-family:Lato;font-size:16px;color:#888;margin:0${hasNav ? " 0 30px" : ""};`}>{first.role}</p>
        {hasNav && (
        <div style="display:flex;gap:16px;">
          <button id="t-prev" aria-label="Previous" style="width:58px;height:58px;border-radius:50%;border:2px solid #f0c79e;background:#fff;color:#f28121;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:24px;line-height:1;">&#8249;</button>
          <button id="t-next" aria-label="Next" style="width:58px;height:58px;border-radius:50%;border:none;background:#1f9ca0;color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:24px;line-height:1;">&#8250;</button>
        </div>
        )}
      </div>
    </div>
  </div>
</section>
