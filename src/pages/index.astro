---
// The Vilij — Homepage
// Originally imported from Claude Design project "Webpage creation request"
// (Vilij Homepage.dc.html); rebuilt to the Sep 2026 redesign
// (thevilij_redesign.jpeg), which reorders the page around the problems
// families arrive with rather than the areas of the village.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import JoinCta from "../components/JoinCta.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import { testimonials } from "../data/testimonials";
import * as areas from "../data/areas";
import { imageSize } from "../data/imageSizes";

const monthlyPrice = "£10";

// "Sound familiar?" — each row is where a family might be now, and where The
// Vilij takes them.
const familiar = [
  ["Googling at 2am, unsure whose advice to trust.", "Clear about the next steps and feeling more confident."],
  ["A meeting at school tomorrow and no idea what will happen.", "Feeling prepared and in control with a clear idea of what you want to achieve."],
  ["Explaining your whole life to yet another person.", "A community that already gets it. Skip the backstory."],
  ["Being told to &ldquo;make time for yourself&rdquo;. Lovely. When?", "Having a quick and easy way to feel at ease."],
];

// The homepage's area tiles carry their own copy — a question a parent is
// already asking, rather than the area's strapline — so they are not the
// shared AreaCard. Only the image comes from src/data/areas.ts.
//
// They are deliberately not links (client, Sep 2026): the site is a single
// page, and the only things to click are the join and log-in buttons. So each
// tile is a plain <div> with no hover lift, which would invite a click.
//
// Order: the three areas open at launch fill the top row (Damien, 31 Jul
// 2026), then Wellbeing, the village illustration, and Library.
const tiles = [
  { area: areas.cafe, label: "CAF&Eacute;", title: "Just need someone who gets it?", body: "Come into the community and ask, vent, laugh, share or connect without having to explain your entire life first." },
  { area: areas.hall, label: "VILIJ HALL", title: "Wondering if anyone else is dealing with this?", body: "Real stories, live chats with experts and tiny wins worth celebrating. Spoiler: they are, and they&rsquo;re lovely." },
  { area: areas.expertHub, label: "EXPERT HUB", title: "What happens when I&rsquo;m not here anymore?", body: "Legal, financial and future-planning experts who actually understand SEND, not just a generic adviser." },
  { area: areas.wellbeing, label: "WELLBEING CENTRE", title: "&ldquo;I can&rsquo;t do this anymore&rdquo;", body: "Practical ways to move forward with a realistic plan." },
  null,
  { area: areas.library, label: "LIBRARY", title: "Got an EHCP meeting coming up?", body: "Know what questions to ask, what the terminology means and where to turn when you&rsquo;re unsure." },
];

const membership = [
  ["A community of SEND parents, carers and grandparents who get it", "Welcome to the Caf&eacute;"],
  ["Trusted experts across education, health, money and more", "Welcome to The Expert Hub"],
  ["Real stories, expert interviews and a place of belonging", "Welcome to The Vilij Hall"],
  ["Support for you, depending on what you need &amp; how much energy you have", "Welcome to The Wellbeing Centre"],
  ["Guides, documents and templates to save you time and stress", "Welcome to The Library"],
  ["New support and resources", "Added as The Vilij grows"],
];

const whyNow = [
  ["EHCP review coming up?", "Join now and use the relevant resources before your meeting."],
  ["Starting a new school?", "Use the transition support inside The Vilij."],
  ["Appointment coming up?", "Use the templates and guidance to help prepare."],
  ["Half term next week?", "See the practical resources and community advice before routine changes."],
  ["Just had a diagnosis and your head&rsquo;s spinning", "Find support from people who understand the journey."],
  ["Running on empty, and it&rsquo;s only Tuesday", "Use the templates and guidance to help prepare."],
];

const faqs = [
  ["My child is 17 (or 2, or 22). Is this still right for me?", "Yes. Families join at every stage, from first worries and waiting lists right through to adulthood. If we&rsquo;re missing something you need, tell us. We listen."],
  ["We don&rsquo;t have a diagnosis yet. Can I join?", "You don&rsquo;t need a diagnosis to belong here. Wondering, waiting and pushing for answers all count, and there&rsquo;s a Caf&eacute; circle for early concerns."],
  ["Is this just for autism?", "No. The Vilij is for families of children and young people with any special educational need or disability. Your child&rsquo;s needs don&rsquo;t have to look like anyone else&rsquo;s to be welcome."],
  ["I&rsquo;m a grandparent, carer or foster carer. Is this for me?", "Very much so. Steph, our co-founder, is a SEND nan. There are Caf&eacute; conversations for grandparents, foster carers, adoptive parents and siblings, so you&rsquo;ll find your people."],
  ["How is this different from the free Facebook groups I&rsquo;m already in?", "Keep the ones you love. The Vilij adds what a big free group can&rsquo;t: a calm, moderated space, experts who are personally known and vetted, guides and templates you can actually use, and everything in one place. So you&rsquo;re not scrolling through 37 conflicting replies at 11pm."],
  ["Is it safe? Who&rsquo;s looking after the community?", "The Vilij is moderated, there are clear community guidelines and a simple way to report a concern. Each Vilijer has a nickname so you can engage anonymously. Our safeguarding policy is published for everyone to read."],
  ["How does it work, and can I cancel?", `It&rsquo;s ${monthlyPrice} a month. Instant access as soon as you join. Cancel anytime from your account.`],
];
---

<BaseLayout
  title="The Vilij — Online Support Community for SEND Families"
  description="The Vilij is an online community for SEND families in the UK: peer support, expert-led guidance on education and health, resources and wellbeing support."
  carousel={testimonials}
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard-img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vnav-cta:hover { background: #15838a !important; }
    </style><div style="font-family:Lato,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(to bottom, rgba(255,255,255,0) 58%, #ffffff 100%), linear-gradient(108deg, #fde7d0 0%, #f6e6d6 42%, #dcecea 74%, #d3edee 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <!-- nav -->
          <SiteNav />
          <!-- hero body -->
          <div class="vhero" style="display:grid;grid-template-columns:1.05fr 1fr;gap:30px;align-items:center;padding:48px 0 70px;">
            <div>
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                <img src="/assets/houseicon.png" alt="" width="269" height="250" decoding="async" style="width:26px;height:auto;" />
                <span style="font-family:Lato;font-size:21px;color:#3a3a3a;">For SEND parents, grandparents and carers</span>
              </div>
              <h1 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.1;color:#1f9ca0;margin:0 0 24px;">Everything you wish someone had told you about life as a SEND parent, in one place.</h1>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0 0 14px;max-width:520px;">Clear guidance on EHCPs, education, health and benefits, from trusted experts. Guides, templates and checklists you can use tonight. Real stories from SEND families and a community that gets it, so you don&rsquo;t have to explain your whole life first.</p>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#222;margin:0 0 24px;">All for {monthlyPrice} a month.</p>
              <JoinCta price={monthlyPrice} />
            </div>
            <div class="vhero-art" style="display:flex;justify-content:center;">
              <img src="/assets/hero_village.png" alt="The Vilij village" width="1240" height="776" fetchpriority="high" decoding="async" style="width:100%;max-width:620px;height:auto;display:block;" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== TEAL STRAPLINE BAR ===== -->
      <div style="background:#1f9ca0;">
        <p class="vwrap" style="max-width:1240px;margin:0 auto;padding:22px 48px;text-align:center;font-family:Lato;font-weight:400;font-size:30px;line-height:1.3;color:#ffffff;">Fewer &ldquo;who do I actually trust?&rdquo; spirals.<br />Far less working it all out on your own.</p>
      </div>

      <!-- ===== SOUND FAMILIAR? ===== -->
      <section style="background:#fdf1e8;padding:80px 0 90px;">
        <div class="vwrap" style="max-width:1100px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#1f9ca0;text-align:center;margin:0 0 50px;">Sound familiar?</h2>
          <div class="vfamiliar" style="display:grid;grid-template-columns:1fr 80px 1fr;gap:20px 24px;align-items:stretch;">
            <h3 style="font-family:Lato;font-weight:700;font-size:21px;letter-spacing:.3px;color:#f28121;margin:0 0 6px;">WHERE YOU MIGHT BE RIGHT NOW</h3>
            <span aria-hidden="true"></span>
            <h3 class="vfamiliar-to" style="font-family:Lato;font-weight:700;font-size:21px;letter-spacing:.3px;color:#1f9ca0;margin:0 0 6px;">WHERE THE VILIJ TAKES YOU</h3>
            {familiar.map(([now, next]) => (
              <>
                <p style="margin:0;background:#f28121;color:#ffffff;border-radius:14px;padding:16px 22px;font-family:Lato;font-size:20px;line-height:1.35;display:flex;align-items:center;" set:html={now}></p>
                <span class="varrow" aria-hidden="true" style="display:flex;align-items:center;justify-content:center;"><svg width="46" height="34" viewBox="0 0 46 34" fill="none" stroke="#f28121" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h38M27 3l14 14-14 14" /></svg></span>
                <p style="margin:0;background:#1f9ca0;color:#ffffff;border-radius:14px;padding:16px 22px;font-family:Lato;font-weight:700;font-size:20px;line-height:1.35;display:flex;align-items:center;" set:html={next}></p>
              </>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== EVERYTHING IN ONE PLACE ===== -->
      <section id="explore" style="background:#ffffff;padding:90px 0 90px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.15;color:#1f9ca0;text-align:center;margin:0 auto 54px;max-width:900px;">Everything in one place, built around the things that actually keep you up</h2>
          <div class="vtiles" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;align-items:center;">
            {tiles.map((t, i) => {
              if (!t) {
                return <img src="/assets/village_sm.png" alt="The Vilij community" width="760" height="475" loading="lazy" decoding="async" style="width:100%;height:auto;display:block;" />;
              }
              // Alternate the gradient's direction so neighbouring tiles do not
              // read as one continuous band, as in the design.
              const bg = i % 2 === 0
                ? "linear-gradient(135deg,#fde7d0 0%,#f3e6d9 40%,#d8eae8 72%,#9fd3d3 100%)"
                : "linear-gradient(135deg,#9fd3d3 0%,#d8eae8 34%,#f3e6d9 66%,#fde7d0 100%)";
              return (
                <div
                  style={`border-radius:18px;overflow:hidden;background:${bg};box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;height:100%;padding:22px 24px 28px;`}>
                  <span style="font-family:Lato;font-weight:700;font-size:20px;letter-spacing:.3px;color:#f28121;" set:html={t.label}></span>
                  <img src={t.area.img} alt="" width={imageSize(t.area.img)?.w} height={imageSize(t.area.img)?.h} loading="lazy" decoding="async" class="vcard-img" style="margin:4px 0 8px;" />
                  <h3 style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.2;color:#1f9ca0;margin:0 0 10px;" set:html={t.title}></h3>
                  <p style="font-family:Lato;font-size:17px;line-height:1.5;color:#3a3a3a;margin:0;" set:html={t.body}></p>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <!-- ===== MEMBERSHIP ORANGE BAND ===== -->
      <section class="vband" style="background:#f28121;padding:70px 0 80px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#ffffff;text-align:center;margin:0 0 46px;">Everything you need, for {monthlyPrice} a month.</h2>
          <div class="vmember" style="display:grid;grid-template-columns:1.3fr 1fr;gap:50px;align-items:center;">
            <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px;">
              {membership.map(([what, where]) => (
                <li style="display:flex;gap:10px;align-items:flex-start;">
                  <span aria-hidden="true" style="width:22px;height:22px;flex:none;margin-top:2px;border-radius:50%;background:#1f9ca0;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;">&#10003;</span>
                  <span style="font-family:Lato;font-size:19px;line-height:1.35;color:#ffffff;"><span set:html={what}></span><br /><span style="font-size:16px;opacity:.92;" set:html={where}></span></span>
                </li>
              ))}
            </ul>
            <div style="background:#ffffff;border-radius:22px;padding:34px 36px 36px;box-shadow:0 14px 36px rgba(0,0,0,0.12);">
              <p style="font-family:Lato;font-weight:700;font-size:20px;letter-spacing:.3px;color:#f28121;margin:0 0 4px;">THE VILIJ MEMBERSHIP</p>
              <p style="font-family:Lato;font-weight:700;color:#1f9ca0;margin:0 0 18px;line-height:1;"><span style="font-size:74px;">{monthlyPrice}</span> <span style="font-size:40px;font-weight:400;">a month</span></p>
              <p style="font-family:Lato;font-weight:700;font-size:20px;line-height:1.4;color:#222;margin:0 0 22px;">That&rsquo;s less than 33p per day.<br />That&rsquo;s not bad for a whole SEND village.</p>
              <JoinCta price={monthlyPrice} />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== WHY NOW? ===== -->
      <section style="background:#ffffff;padding:90px 0 90px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.15;color:#1f9ca0;text-align:center;margin:0 0 50px;">Why now?<br />There&rsquo;s always another SEND &lsquo;thing&rsquo;.<br /><span style="color:#f28121;">You don&rsquo;t have to face it alone.</span></h2>
          <div class="vwhy" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-bottom:46px;">
            {whyNow.map(([q, a], i) => (
              <div style={`background:${i % 3 === 1 ? "#1f9ca0" : "#f28121"};border-radius:18px;padding:26px 26px 28px;text-align:center;color:#ffffff;`}>
                <h3 style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.25;margin:0 0 8px;" set:html={q}></h3>
                <p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;" set:html={a}></p>
              </div>
            ))}
          </div>
          <JoinCta price={monthlyPrice} align="center" />
        </div>
      </section>

      <!-- ===== BUILT BY FAMILIES ===== -->
      <section id="about" style="background:#fdf1e8;padding:80px 0;">
        <div class="vwrap vbuilt" style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1.4fr 1fr;gap:56px;align-items:center;">
          <div>
            <h2 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.08;color:#1f9ca0;margin:0 0 26px;">Built by families who<br />live this life.</h2>
            <p style="font-family:Lato;font-weight:700;font-size:21px;line-height:1.45;color:#222;margin:0 0 12px;">The Vilij was started by Charlie, a SEND mum, and Steph, a SEND nan.</p>
            <p style="font-family:Lato;font-size:18px;line-height:1.55;color:#444;margin:0 0 12px;">We know the late-night Googling, the hospital corridors and the meetings where you&rsquo;re the only one who&rsquo;s read the paperwork.</p>
            <p style="font-family:Lato;font-weight:700;font-size:20px;line-height:1.45;color:#222;margin:0;">So we built the place we wished had existed.</p>
          </div>
          <img src="/assets/p_founders.png" alt="Vilij founders Charlie and Steph" width="389" height="536" loading="lazy" decoding="async" style="width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:50% 30%;border-radius:14px;display:block;box-shadow:0 14px 28px rgba(0,0,0,0.14);" />
        </div>
      </section>

      <!-- ===== TESTIMONIALS ===== -->
      <TestimonialCarousel list={testimonials} />

      <!-- ===== FAQ ===== -->
      <section style="background:#d6ecec;padding:80px 0 90px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.12;color:#1f9ca0;text-align:center;margin:0 0 44px;">Questions you&rsquo;re probably thinking<br />(we would be too).</h2>
          <div style="max-width:1000px;margin:0 auto;display:flex;flex-direction:column;gap:26px;">
            {faqs.map(([q, a]) => (
              <div>
                <h3 style="font-family:Lato;font-weight:700;font-size:22px;line-height:1.3;color:#222;margin:0 0 6px;" set:html={q}></h3>
                <p style="font-family:Lato;font-size:18px;line-height:1.55;color:#333;margin:0;" set:html={a}></p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ===== FINAL CTA ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:70px 24px 76px;">
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 20px;">Your village is waiting for you.</h2>
        <p style="font-family:Lato;font-size:22px;line-height:1.45;color:#fff;margin:0 0 32px;">You don&rsquo;t need to be at breaking point.<br />You don&rsquo;t need to have it all together.<br />You&rsquo;re allowed support too.</p>
        <JoinCta price={monthlyPrice} tone="onOrange" align="center" />
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter />

    </div>
</BaseLayout>
