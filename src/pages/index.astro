---
// The Vilij — Homepage
// Imported from Claude Design project "Webpage creation request" (Vilij Homepage.dc.html)
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AreaTiles from "../components/AreaTiles.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import { showSecondTestimonial } from "../data/testimonials";
import * as areas from "../data/areas";

// Configurable props from the original design component:
const monthlyPrice = "£10";

const testimonials = [
  {
    quote:
      "As a parent of a 22-year-old son with autism, I finally feel understood. The Vilij offers practical support, genuine connection and reminds us we’re never alone.",
    name: "Emily & Loui",
    role: "SEND family, Newcastle-under-Lyme",
    stars: 5,
    photo: "/assets/p_emily_loui.png",
  },
  {
    quote:
      "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat wisi enim ad minim veniam.",
    name: "Charlie & Family",
    role: "SEND Family, The Vilij",
    // Placeholder slot — no real quote, so no rating to show.
    stars: null,
    photo: "/assets/charlie.png",
  },
];

const list = showSecondTestimonial ? testimonials : [testimonials[0]];

// The homepage shows all nine areas, with the village illustration sitting
// unframed in the middle of the grid.
//
// Damien, 31 Jul 2026: "can we swop Library and Expert hub around so all live
// pages are on the top layer please". The grid is three columns, so the top row
// is the first three entries — and with Expert Hub moved up it reads Café,
// Vilij Hall, Expert Hub, which is exactly the three areas open at launch.
// Library takes Expert Hub's old slot in the middle row alongside Wellbeing,
// with the other coming-soon areas.
//
// If an area opens or closes, re-sort so the live ones fill this first row
// again. That is the rule; the specific order below is just today's answer.
const gridItems = [
  areas.cafe,
  areas.hall,
  areas.expertHub,
  areas.wellbeing,
  { label: "Village illustration (no card)", img: "/assets/village_sm.png", alt: "The Vilij community", framed: false },
  areas.library,
  areas.highStreet,
  areas.marketPlace,
  areas.campus,
];
---

<BaseLayout
  title="The Vilij — Online Support Community for SEND Families"
  description="The Vilij is an online community for SEND families in the UK: peer support, expert-led guidance on education and health, resources and wellbeing support."
  carousel={list}
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard { transition: transform .25s ease, box-shadow .25s ease; }
      .vcard-img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vcard:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(40,80,90,0.16) !important; }
      .vnav-cta:hover { background: #15838a !important; }
    </style><div style="font-family:Lato,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(to bottom, rgba(255,255,255,0) 58%, #ffffff 100%), linear-gradient(108deg, #fde7d0 0%, #f6e6d6 42%, #dcecea 74%, #d3edee 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <!-- nav -->
          <SiteNav />
          <!-- hero body -->
          <div class="vhero" style="display:grid;grid-template-columns:1fr 1.05fr;gap:30px;align-items:center;padding:48px 0 90px;">
            <div>
              <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                <img src="/assets/houseicon.png" alt="" width="269" height="250" decoding="async" style="width:30px;height:auto;" />
                <span style="font-family:Lato;font-size:23px;color:#3a3a3a;">Welcome to The Vilij</span>
              </div>
              <h1 style="font-family:Lato;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 26px;letter-spacing:-1px;">You were never meant to do this alone.</h1>
              <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:560px;">Raising a child with additional needs can be overwhelming, even when you&rsquo;re coping.</p>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0 0 18px;max-width:560px;">The Vilij is a calm, kind place for SEND families, where you&rsquo;re understood without needing to explain, guided without judgement, and supported by people who actually get it.</p>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0;max-width:560px;">Think of us as your online village community.</p>
            </div>
            <div class="vhero-art" style="display:flex;justify-content:center;">
              <img src="/assets/hero_village.png" alt="The Vilij village" width="1240" height="776" fetchpriority="high" decoding="async" style="width:100%;max-width:620px;height:auto;display:block;" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== BE MORE BAR ===== -->
      <div style="background:#2bbfba;">
        <div class="vwrap vbar" style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== EVERYTHING YOU NEED ===== -->
      <section id="explore" style="background:#ffffff;padding:84px 0 90px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#1f9ca0;text-align:center;margin:0 0 50px;">Everything you need, in one place.</h2>
          <!-- 5 features -->
          <div class="vfeat5" style="display:grid;grid-template-columns:repeat(5,1fr);gap:24px;margin-bottom:64px;text-align:center;">
            <div><p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;color:#353535;"><strong style="color:#f28121;font-weight:700;">Real-life community spaces</strong> where you&rsquo;re seen, not judged</p></div>
            <div><p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;color:#353535;"><strong style="color:#f28121;font-weight:700;">Expert-led guidance</strong> on education, health, EHCPs &amp; benefits</p></div>
            <div><p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;color:#353535;"><strong style="color:#f28121;font-weight:700;">Lived-experience wisdom</strong> that makes everything feel more human</p></div>
            <div><p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;color:#353535;"><strong style="color:#f28121;font-weight:700;">Bite-size resources</strong> you can use even on the hardest days</p></div>
            <div><p style="font-family:Lato;font-size:18px;line-height:1.45;margin:0;color:#353535;"><strong style="color:#f28121;font-weight:700;">Wellbeing support</strong> that helps you breathe again</p></div>
          </div>
          <!-- cards grid -->
          <div class="vtiles" style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;"><AreaTiles items={gridItems} />
          </div>
        </div>
      </section>

      <!-- ===== APP SIGNUP ORANGE BAND ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:62px 24px;">
        <p style="font-family:Lato;font-size:20px;color:#ffffff;margin:0 0 8px;">So what do I do next?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 14px;">Sign up to The Vilij App.</h2>
        <p style="font-family:Lato;font-size:22px;color:#fff;margin:0 0 34px;">Everything SEND in one place for just {monthlyPrice} per month.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#1f9ca0;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">JOIN US NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== STILL NOT SURE TEAL BAND ===== -->
      <section class="vband-sm" style="background:#1f9ca0;padding:30px 24px;">
        <div style="display:flex;align-items:center;justify-content:center;gap:34px;flex-wrap:wrap;">
          <span style="font-family:Lato;font-weight:400;font-size:34px;color:#d7f0f0;">Still not sure?</span>
          <a href="#" class="vpill" style="display:inline-flex;align-items:center;gap:14px;background:#f28121;color:#fff;font-family:Lato;font-weight:700;font-size:18px;letter-spacing:.5px;padding:12px 14px 12px 30px;border-radius:32px;text-decoration:none;box-shadow:0 8px 20px rgba(0,0,0,0.15);">TAKE A SNEAKY PEEK <span style="width:38px;height:38px;border-radius:50%;background:#ffffff;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:10px solid #1f9ca0;border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:3px;"></span></span></a>
        </div>
      </section>

      <!-- ===== BENEFITS PANEL ===== -->
      <section style="background:#ffffff;padding:80px 0 30px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div class="vpanel3" style="border-radius:26px;background:linear-gradient(108deg,#fde7d0 0%,#f6e6d6 40%,#dcecea 74%,#d3edee 100%);padding:54px 56px;display:grid;grid-template-columns:repeat(3,1fr);gap:46px;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <div>
              <h3 style="font-family:Lato;font-weight:700;font-size:30px;color:#1f9ca0;margin:0 0 16px;line-height:1.15;">Community that understands</h3>
              <p style="font-family:Lato;font-size:18px;line-height:1.55;color:#3a3a3a;margin:0;">A safe, judgement-free space where you don&rsquo;t have to perform or pretend. Just real people who get it.</p>
            </div>
            <div>
              <h3 style="font-family:Lato;font-weight:700;font-size:30px;color:#1f9ca0;margin:0 0 16px;line-height:1.15;">Experts on your side</h3>
              <p style="font-family:Lato;font-size:18px;line-height:1.55;color:#3a3a3a;margin:0;">Clear, calm guidance for EHCPs, school battles, transitions, therapies and everything in between.</p>
            </div>
            <div>
              <h3 style="font-family:Lato;font-weight:700;font-size:30px;color:#1f9ca0;margin:0 0 16px;line-height:1.15;">Wellbeing support</h3>
              <p style="font-family:Lato;font-size:18px;line-height:1.55;color:#3a3a3a;margin:0;">Let us help you breathe again.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== BUILT BY FAMILIES ===== -->
      <section id="about" style="background:#ffffff;padding:56px 0 80px;">
        <div class="vwrap vbuilt" style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1.15fr 1fr;gap:56px;align-items:start;">
          <div>
            <p style="font-family:Lato;font-size:22px;color:#3a3a3a;margin:0 0 10px;">How We Can Support You</p>
            <h2 style="font-family:Lato;font-weight:700;font-size:50px;line-height:1.05;color:#f28121;margin:0 0 28px;">Built by families who live this life.</h2>
            <p style="font-family:Lato;font-weight:700;font-size:20px;line-height:1.5;color:#353535;margin:0 0 18px;">We know the fierce love we feel for our children and the exhaustion that comes from battling systems just to secure the life they deserve.</p>
            <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0 0 16px;">We know the late-night Googling, the meetings, the advocacy, and the moments that feel overwhelming, lonely and frightening. Many of us have sat in hospital corridors, school meetings, and waiting rooms wondering if anyone else understands this life.</p>
            <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0 0 16px;">We&rsquo;ve been there. We&rsquo;ve felt it all. And we believe no family should have to navigate it alone.</p>
            <p style="font-family:Lato;font-weight:700;font-size:20px;line-height:1.5;color:#353535;margin:0;">The Vilij is where you find your people.</p>
          </div>
          <div class="vstory" style="background:#fbe2cd;border-radius:22px;padding:32px;display:grid;grid-template-columns:0.8fr 1.3fr;gap:22px;align-items:center;">
            <div>
              <h3 style="font-family:Lato;font-weight:700;font-size:30px;line-height:1.08;color:#1f9ca0;margin:0 0 16px;">Charlie&rsquo;s Story</h3>
              <p style="font-family:Lato;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0;">Find out more about our founder Charlie&rsquo;s journey through her lived experience.</p>
            </div>
            <img src="/assets/charlie.png" alt="Charlie and family" width="496" height="411" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:14px;display:block;box-shadow:0 8px 20px rgba(0,0,0,0.12);" />
          </div>
        </div>
      </section>

      <!-- ===== BE MORE BAR 2 ===== -->
      <div style="background:#2bbfba;">
        <div class="vwrap vbar" style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== TESTIMONIALS ===== -->
      <TestimonialCarousel list={list} />

      <!-- ===== FINAL CTA ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:66px 24px;">
        <p style="font-family:Lato;font-size:22px;color:#ffffff;margin:0 0 10px;">So, you&rsquo;ve come this far?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 22px;">Your village is waiting for you.</h2>
        <p style="font-family:Lato;font-weight:700;font-size:24px;line-height:1.5;color:#fff;margin:0 0 36px;">You don&rsquo;t need to be at breaking point.<br />You don&rsquo;t need to have it all together.<br />You&rsquo;re allowed support too.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#f28121;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">SIGN UP NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter />

    </div>
</BaseLayout>
