        n: "13.4",
        text: "Where you have contributed content to community discussions, forums, comments or other Platform features, certain content may remain visible following account closure or deletion where reasonably necessary to:",
        items: [
          "preserve the integrity and context of community discussions;",
          "maintain moderation, complaint or safeguarding records;",
          "comply with legal obligations; or",
          "establish, exercise or defend legal claims.",
        ],
      },
      { n: "13.5", text: "Where appropriate, personal data may be deleted, anonymised or aggregated so that it can no longer be associated with an identifiable individual." },
      { n: "13.6", text: "We may retain personal data for longer than the periods described above where required by law or where reasonably necessary in connection with legal proceedings, investigations, complaints, safeguarding matters or regulatory requirements." },
    ],
  },
  {
    n: "14",
    title: "Your Rights",
    clauses: [
      {
        n: "14.1",
        text: "Subject to applicable data protection laws, you may have the right to:",
        items: [
          "request access to the personal data we hold about you;",
          "request correction of inaccurate or incomplete personal data;",
          "request deletion of your personal data in certain circumstances;",
          "request restriction of processing in certain circumstances;",
          "object to the processing of your personal data in certain circumstances;",
          "request the transfer of your personal data to you or another organisation, where applicable;",
          "withdraw consent where we rely on consent as the legal basis for processing; and",
          "complain about our handling of your personal data.",
        ],
      },
      { n: "14.2", text: "If you wish to exercise any of your rights, please contact us using the details set out in this Privacy Policy.", note: "Requests may be submitted by email to: privacy@thevilij.co.uk" },
      { n: "14.3", text: "We may ask you to provide information to verify your identity before responding to a request." },
      { n: "14.4", text: "We will respond to requests in accordance with applicable data protection laws." },
      { n: "14.5", text: "The exercise of certain rights may be subject to legal exemptions and limitations. Where we are unable to comply with a request, we will explain the reasons unless we are legally prevented from doing so." },
      { n: "14.6", text: "If you are unhappy with how we have handled your personal data or responded to a request, you have the right to complain to the Information Commissioner’s Office. Further information is available from the Information Commissioner’s Office.", ico: true },
    ],
  },
  {
    n: "15",
    title: "Complaints",
    clauses: [
      { n: "15.1", text: "If you have any concerns about how we collect, use or otherwise process your personal data, we encourage you to contact us first so that we have an opportunity to investigate and address your concerns. You can contact us using the details set out in this Privacy Policy." },
      { n: "15.2", text: "You also have the right to lodge a complaint with the UK data protection regulator, the Information Commissioner’s Office, if you believe that we have processed your personal data in breach of applicable data protection laws. Further information is available from the Information Commissioner’s Office.", ico: true },
    ],
  },
  {
    n: "16",
    title: "Cookies",
    clauses: [
      { n: "16.1", text: "We use cookies and similar technologies to operate, maintain and improve the Platform." },
      {
        n: "16.2",
        text: "Cookies may be used to:",
        items: [
          "enable core Platform functionality;",
          "remember user preferences;",
          "improve security;",
          "analyse how the Platform is used; and",
          "enhance user experience.",
        ],
      },
      { n: "16.3", text: "Further information about the cookies we use and how you can manage your cookie preferences is available in our Cookie Policy." },
    ],
  },
];

const letters = "abcdefghijklmnopqrstuvwxyz".split("");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title>Privacy Policy | The Vilij</title>
    <meta name="description" content="How The Vilij collects, uses, stores, shares and protects the personal data of SEND families using the Platform, and the data rights you have under UK GDPR." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vnav-cta:hover { background: #15838a !important; }
      .vclause { display: grid; grid-template-columns: 72px 1fr; gap: 0 12px; margin: 0 0 20px; }
      .vsub { display: grid; grid-template-columns: 44px 1fr; gap: 0 12px; margin: 12px 0 0; }
      .vtoc a:hover { color: #f28121 !important; }
      @media (max-width: 820px) {
        .vclause { grid-template-columns: 54px 1fr; }
        .vsub { grid-template-columns: 34px 1fr; }
      }
    </style>
  </head>
  <body>
    <div style="font-family:Mulish,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <nav style="display:flex;align-items:center;justify-content:space-between;">
            <a href="/"><img src="/assets/logo.png" alt="The Vilij" style="height:62px;width:auto;display:block;" /></a>
            <div style="display:flex;align-items:center;gap:42px;">
              <a href="/" class="vlink" style="font-family:Quicksand;font-weight:700;font-size:18px;color:#1f9ca0;text-decoration:none;">Home</a>
              <a href="#" class="vlink" style="font-family:Quicksand;font-weight:600;font-size:18px;color:#1f9ca0;text-decoration:none;">Explore The Vilij</a>
              <a href="#" class="vlink" style="font-family:Quicksand;font-weight:600;font-size:18px;color:#1f9ca0;text-decoration:none;">About Us</a>
              <a href="#" class="vnav-cta vpill" style="font-family:Quicksand;font-weight:700;font-size:16px;letter-spacing:.5px;color:#ffffff;background:#1f9ca0;padding:13px 30px;border-radius:30px;text-decoration:none;box-shadow:0 6px 16px rgba(31,156,160,0.3);">SIGN UP</a>
            </div>
          </nav>
          <div style="padding:54px 0 70px;max-width:820px;">
            <h1 style="font-family:Quicksand;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Privacy Policy</h1>
            <p style="font-family:Mulish;font-weight:800;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:640px;">Your trust matters to us, and so does your family&rsquo;s privacy.</p>
            <p style="font-family:Mulish;font-size:19px;line-height:1.55;color:#444;margin:0 0 30px;max-width:640px;">This policy explains how The Vilij collects, uses, stores and protects the personal data you share with us &mdash; and the rights you have over it.</p>
            <p style="font-family:Mulish;font-weight:700;font-size:16px;letter-spacing:.4px;color:#1f9ca0;margin:0;display:inline-block;background:rgba(255,255,255,0.6);border-radius:24px;padding:11px 22px;">Effective from <time datetime="2026-07-29">29 July 2026</time></p>
          </div>
        </div>
      </section>

      <!-- ===== BAND ===== -->
      <div style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Quicksand;font-weight:500;font-size:36px;color:#ffe9d6;margin:0;">Because sharing your story should always feel safe.</p>
      </div>

      <!-- ===== CONTENTS ===== -->
      <section style="background:#ffffff;padding:70px 0 10px;">
        <div style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div style="border-radius:26px;background:linear-gradient(90deg,#f6c79a 0%,#fbe5d1 26%,#ffffff 50%,#cfeae8 74%,#a4dbd7 100%);padding:42px 40px 46px;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <h2 style="font-family:Quicksand;font-weight:700;font-size:38px;color:#1f9ca0;margin:0 0 24px;text-align:center;">What&rsquo;s In This Policy</h2>
            <div class="vtoc" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px 34px;">
              {sections.map((s) => (
                <a href={`#s${s.n}`} style="font-family:Mulish;font-weight:600;font-size:17px;color:#2a2a2a;text-decoration:none;">
                  <span style="color:#f28121;font-weight:800;">{s.n}.</span> {s.title}
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ===== POLICY BODY ===== -->
      <section style="background:#ffffff;padding:40px 0 80px;">
        <div style="max-width:1000px;margin:0 auto;padding:0 48px;">

          {sections.map((s) => (
            <div id={`s${s.n}`} style="padding-top:46px;">
              <h2 style="font-family:Quicksand;font-weight:700;font-size:38px;line-height:1.15;color:#1f9ca0;margin:0 0 24px;">
                <span style="color:#f28121;">{s.n}.</span> {s.title}
              </h2>

              {s.intro && (
                <p style="font-family:Mulish;font-size:18px;line-height:1.65;color:#444;margin:0 0 24px;">{s.intro}</p>
              )}

              {s.clauses.map((c) => (
                <div class="vclause">
                  <span style="font-family:Mulish;font-weight:800;font-size:18px;line-height:1.65;color:#1f9ca0;">{c.n}</span>
                  <div>
                    <p style="font-family:Mulish;font-size:18px;line-height:1.65;color:#444;margin:0;">
                      {c.lead && <strong style="color:#222;">{c.lead}</strong>}{c.text}
                    </p>

                    {c.contact && (
                      <div style="margin:20px 0 4px;border-radius:18px;background:#f4faf9;border:1px solid #d9ecea;padding:26px 28px;">
                        <p style="font-family:Quicksand;font-weight:700;font-size:22px;color:#1f9ca0;margin:0 0 14px;">The Vilij Limited</p>
                        <p style="font-family:Mulish;font-size:17px;line-height:1.7;color:#444;margin:0 0 10px;">Registered in England and Wales under company number 16718802</p>
                        <p style="font-family:Mulish;font-size:17px;line-height:1.7;color:#444;margin:0 0 10px;">Registered office: The Meakin Suite, Ravenscliffe, First Avenue, Newcastle Under Lyme, Staffordshire, United Kingdom, ST5 8QX</p>
                        <p style="font-family:Mulish;font-size:17px;line-height:1.7;color:#444;margin:0 0 6px;">Email: <a href="mailto:privacy@thevilij.co.uk" class="vlink" style="color:#f28121;font-weight:700;text-decoration:none;">privacy@thevilij.co.uk</a></p>
                        <p style="font-family:Mulish;font-size:17px;line-height:1.7;color:#444;margin:0;">Safeguarding concerns: <a href="mailto:safeguarding@thevilij.co.uk" class="vlink" style="color:#f28121;font-weight:700;text-decoration:none;">safeguarding@thevilij.co.uk</a></p>
                      </div>
                    )}

                    {c.items && (
                      <div style="margin-bottom:4px;">
                        {c.items.map((item, i) => (
                          <div class="vsub">
                            <span style="font-family:Mulish;font-weight:700;font-size:17px;line-height:1.65;color:#f28121;">({letters[i]})</span>
                            <span style="font-family:Mulish;font-size:17px;line-height:1.65;color:#444;">{item}</span>
                          </div>
                        ))}
                      </div>
                    )}

                    {c.table && (
                      <div style="margin:22px 0 4px;overflow-x:auto;">
                        <table style="width:100%;border-collapse:collapse;font-family:Mulish;font-size:16px;min-width:520px;">
                          <thead>
                            <tr>
                              <th style="text-align:left;font-family:Quicksand;font-weight:700;font-size:18px;color:#ffffff;background:#1f9ca0;padding:14px 18px;border-radius:12px 0 0 0;width:42%;">Data Type</th>
                              <th style="text-align:left;font-family:Quicksand;font-weight:700;font-size:18px;color:#ffffff;background:#1f9ca0;padding:14px 18px;border-radius:0 12px 0 0;">Typical Retention Period</th>
                            </tr>
                          </thead>
                          <tbody>
                            {c.table.map((row, i) => (
                              <tr style={i % 2 === 1 ? "background:#f7fbfb;" : ""}>
                                <td style="padding:14px 18px;line-height:1.55;color:#222;font-weight:700;border-bottom:1px solid #e7eeee;vertical-align:top;">{row[0]}</td>
                                <td style="padding:14px 18px;line-height:1.55;color:#555;border-bottom:1px solid #e7eeee;vertical-align:top;">{row[1]}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}

                    {c.note && (
                      <p style="font-family:Mulish;font-size:17px;line-height:1.65;color:#555;margin:16px 0 0;padding-left:16px;border-left:3px solid #f6c79a;">{c.note}</p>
                    )}

                    {c.ico && (
                      <p style="font-family:Mulish;font-size:17px;line-height:1.65;margin:10px 0 0;">
                        <a href="https://ico.org.uk/" target="_blank" rel="noopener" class="vlink" style="color:#f28121;font-weight:700;text-decoration:none;">Visit the Information Commissioner&rsquo;s Office &rarr;</a>
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          ))}

        </div>
      </section>

      <!-- ===== QUESTIONS CTA ===== -->
      <section style="background:#f28121;text-align:center;padding:66px 24px;">
        <p style="font-family:Mulish;font-size:22px;color:#ffe6cf;margin:0 0 10px;">Still got a question?</p>
        <h2 style="font-family:Quicksand;font-weight:700;font-size:62px;color:#ffffff;margin:0 0 22px;">We&rsquo;re happy to help.</h2>
        <p style="font-family:Mulish;font-weight:600;font-size:24px;line-height:1.5;color:#fff;margin:0 0 36px;">If anything here isn&rsquo;t clear, or you&rsquo;d like to exercise your data rights,<br />just get in touch and a real person will come back to you.</p>
        <a href="mailto:privacy@thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#f28121;font-family:Quicksand;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">EMAIL US <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== FOOTER ===== -->
      <footer style="background:#ffffff;padding:74px 0 30px;">
        <div style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1.3fr 1fr 1fr 1.4fr;gap:40px;">
          <div>
            <img src="/assets/footerlogo.png" alt="Vilij" style="height:48px;width:auto;display:block;margin-bottom:18px;" />
            <p style="font-family:Mulish;font-size:17px;line-height:1.55;color:#555;margin:0 0 30px;max-width:280px;">Lorem ipsum dolor ame consectetue adipiscin diam and nonumy euismod laoret dolore magna aliuam.</p>
            <a href="#" id="to-top" style="display:inline-flex;align-items:center;gap:14px;text-decoration:none;cursor:pointer;">
              <span style="width:52px;height:52px;border-radius:50%;border:2px solid #1f9ca0;display:inline-flex;align-items:center;justify-content:center;color:#1f9ca0;font-size:22px;">&#8593;</span>
              <span style="font-family:Mulish;font-size:18px;color:#444;">Back to the top</span>
            </a>
          </div>
          <div>
            <h4 style="font-family:Quicksand;font-weight:700;font-size:24px;color:#1f9ca0;margin:0 0 22px;">About</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">About Us</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Our Story</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">News</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Become a Vilij Elder</a></li>
            </ul>
          </div>
          <div>
            <h4 style="font-family:Quicksand;font-weight:700;font-size:24px;color:#1f9ca0;margin:0 0 22px;">Quick Links</h4>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
              <li><a href="/cafe" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Caf&eacute;</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Free Courses</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Admissions</a></li>
              <li><a href="#" class="vlink" style="font-family:Mulish;font-size:18px;color:#444;text-decoration:none;">Request a Demo</a></li>
            </ul>
          </div>
          <div>
            <h4 style="font-family:Quicksand;font-weight:700;font-size:24px;color:#1f9ca0;margin:0 0 18px;">Join Our Newsletter</h4>
            <p style="font-family:Mulish;font-weight:700;font-size:17px;line-height:1.5;color:#444;margin:0 0 20px;">Lorem ipsum dolor amet, consectetuer adipiscing diam nonummy euismod tincidun.</p>
            <form method="get" action="/newsletter-thanks" style="margin:0;">
              <div style="display:flex;gap:10px;margin-bottom:16px;max-width:380px;">
                <label for="nl-email" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Email address</label>
                <input id="nl-email" name="email" type="email" required placeholder="Your Email Here" style="flex:1;font-family:Mulish;font-size:16px;padding:13px 16px;border:1px solid #ddd;border-radius:8px;outline:none;color:#333;" />
                <button type="submit" class="vpill" style="font-family:Mulish;font-weight:700;font-size:16px;color:#fff;background:#f28121;border:none;border-radius:8px;padding:0 22px;cursor:pointer;">Subscribe</button>
              </div>
              <label style="display:flex;align-items:flex-start;gap:10px;font-family:Mulish;font-size:15px;line-height:1.5;color:#777;cursor:pointer;max-width:380px;">
                <input type="checkbox" name="newsletter_opt_in" value="yes" required style="width:16px;height:16px;margin-top:3px;flex:none;accent-color:#f28121;" />
                <span>I agree to receive newsletter emails and accept the <a href="/privacy" class="vlink" style="color:#777;text-decoration:underline;">privacy policy</a>.</span>
              </label>
            </form>
          </div>
        </div>
        <div style="max-width:1240px;margin:46px auto 0;padding:0 48px;">
          <div style="border-top:1px solid #e7e7e7;padding-top:24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
            <span style="font-family:Mulish;font-size:15px;color:#999;">&copy; Copyright 2026. All rights reserved. Design by Revive Creative.</span>
            <div style="display:flex;align-items:center;gap:16px;font-family:Mulish;font-size:15px;color:#666;">
              <a href="#" class="vlink" style="color:#666;text-decoration:none;">Terms</a><span style="color:#ccc;">&mdash;</span>
              <a href="/privacy" class="vlink" style="color:#666;text-decoration:none;">Privacy</a><span style="color:#ccc;">&mdash;</span>
              <a href="#" class="vlink" style="color:#666;text-decoration:none;">Support</a>
            </div>
          </div>
        </div>
      </footer>

    </div>

    <script>
      (function () {
        const toTop = document.getElementById("to-top");
        if (toTop) toTop.addEventListener("click", function (e) { e.preventDefault(); window.scrollTo({ top: 0, behavior: "smooth" }); });
      })();
    </script>

    <!-- Start of HubSpot Embed Code -->
    <script type="text/javascript" id="hs-script-loader" async defer src="//js-eu1.hs-scripts.com/148725470.js" is:inline></script>
    <!-- End of HubSpot Embed Code -->
  </body>
</html>
