---
// The Vilij — Newsletter sign-up confirmation
// This is the `action` target of the footer newsletter form. It must be a plain
// GET destination: Cloudflare Pages serves static assets and returns 405 to POST.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Astro decodes HTML entities in attribute values, so a title carrying &rsquo;
// has to reach the layout as an expression rather than an attribute.
const title = "You&rsquo;re on the List | The Vilij";
---

<BaseLayout
  title={title}
  description="Thank you for joining The Vilij newsletter. We will be in touch with news, updates and what is on around the Vilij community for SEND families in the UK."
  noindex
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vnav-cta:hover { background: #15838a !important; }
    </style><div style="font-family:Mulish,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <SiteNav />
          <div class="vhero-text" style="padding:80px 0 100px;text-align:center;">
            <h1 style="font-family:Quicksand;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">You&rsquo;re on the list</h1>
            <p style="font-family:Mulish;font-weight:800;font-size:23px;line-height:1.4;color:#353535;margin:0 auto 22px;max-width:620px;">Thank you for joining our newsletter.</p>
            <p style="font-family:Mulish;font-size:19px;line-height:1.55;color:#444;margin:0 auto 40px;max-width:620px;">We&rsquo;ll be in touch with news from around the Vilij &mdash; what&rsquo;s on, what&rsquo;s new, and the things we think will genuinely help. You can unsubscribe at any time.</p>
            <a href="/" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#f28121;color:#ffffff;font-family:Quicksand;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(242,129,33,0.28);">BACK TO THE VILIJ <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
          </div>
        </div>
      </section>

      <!-- ===== BAND ===== -->
      <div class="vband-sm" style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Quicksand;font-weight:500;font-size:36px;color:#ffe9d6;margin:0;">Nobody should have to do this alone.</p>
      </div>

      <!-- ===== WHERE NEXT ===== -->
      <section style="background:#ffffff;padding:80px 0;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Quicksand;font-weight:700;font-size:50px;color:#1f9ca0;margin:0 0 40px;text-align:center;">While You&rsquo;re Here</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px;">
            <a href="/cafe" style="text-decoration:none;background:#f28121;border-radius:22px;padding:34px 32px;display:block;">
              <h3 style="font-family:Quicksand;font-weight:700;font-size:34px;color:#fff;margin:0 0 12px;">The Caf&eacute;</h3>
              <p style="font-family:Mulish;font-size:17px;line-height:1.55;color:rgba(255,255,255,0.95);margin:0;">Where the kettle&rsquo;s always on and someone always understands.</p>
            </a>
            <a href="/library" style="text-decoration:none;background:#1f9ca0;border-radius:22px;padding:34px 32px;display:block;">
              <h3 style="font-family:Quicksand;font-weight:700;font-size:34px;color:#fff;margin:0 0 12px;">The Library</h3>
              <p style="font-family:Mulish;font-size:17px;line-height:1.55;color:rgba(255,255,255,0.95);margin:0;">Practical resources at your fingertips, ready whenever you are.</p>
            </a>
            <a href="/wellbeing" style="text-decoration:none;background:#f28121;border-radius:22px;padding:34px 32px;display:block;">
              <h3 style="font-family:Quicksand;font-weight:700;font-size:34px;color:#fff;margin:0 0 12px;">Wellbeing Centre</h3>
              <p style="font-family:Mulish;font-size:17px;line-height:1.55;color:rgba(255,255,255,0.95);margin:0;">Because you matter too, not just everyone you look after.</p>
            </a>
          </div>
        </div>
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter padding="34px 0 30px" />

    </div>
</BaseLayout>
