---
// The Vilij — Vilij Expert Hub page
// Built from design "Vilij Website Expert Hub page v2.pdf"
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AreasGrid from "../components/AreasGrid.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import { testimonials } from "../data/testimonials";
import * as areas from "../data/areas";

const monthlyPrice = "£10";

// The order of the "What else you can see inside the Vilij" grid, as it stands
// on this page. Every page uses a different order and a different second photo.
const gridItems = [
  areas.hall,
  { label: "Beach photo", img: "/assets/p_beach.jpg", alt: "Child at the beach" },
  areas.cafe,
  areas.library,
  areas.marketPlaceShort,
  areas.highStreet,
  areas.wellbeing,
  { label: "Family photo", img: "/assets/p_jose.jpg", alt: "A SEND family" },
  areas.campus,
];
---

<BaseLayout
  title="Expert Hub — SEND Advice on Education and Health | The Vilij"
  description="The Vilij Expert Hub connects SEND families with trusted professionals for guidance on education, health, legal questions, emotional support and daily life."
  carousel={testimonials}
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard { transition: transform .25s ease, box-shadow .25s ease; }
      .vcard-img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vcard:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(40,80,90,0.16) !important; }
      .vnav-cta:hover { background: #15838a !important; }
    </style><div style="font-family:Lato,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <SiteNav />
          <div class="vhero" style="display:grid;grid-template-columns:1fr 1.05fr;gap:30px;align-items:center;padding:54px 0 70px;">
            <div>
              <h1 style="font-family:Lato;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Welcome to<br />the Expert Hub</h1>
              <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:520px;">Trusted experts, tailored advice, and tools that make a difference.</p>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0;max-width:520px;">This is a place to pause, breathe, and feel understood. It&rsquo;s a calmer way to find the right support, without needing all the answers first.</p>
            </div>
            <div class="vhero-art" style="display:flex;justify-content:center;">
              <img src="/assets/experthub_hero.png" alt="The Vilij Expert Hub" width="1400" height="1084" fetchpriority="high" decoding="async" style="width:100%;max-width:600px;height:auto;display:block;" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== RIGHT PLACE BAND ===== -->
      <div class="vband-sm" style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Lato;font-weight:400;font-size:36px;color:#ffffff;margin:0;">When things feel hard and you&rsquo;re not sure where to start, you&rsquo;re in the right place.</p>
      </div>

      <!-- ===== WHY THE EXPERT HUB EXISTS ===== -->
      <section style="background:#ffffff;padding:90px 0 30px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div class="vpanel-soft" style="border-radius:26px;background:linear-gradient(90deg,#f6c79a 0%,#fbe5d1 26%,#ffffff 50%,#cfeae8 74%,#a4dbd7 100%);padding:50px 40px 56px;text-align:center;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#1f9ca0;margin:0 0 26px;">Why The Expert Hub Exists</h2>
            <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.5;color:#222;margin:0 auto 28px;max-width:820px;">Knowing who to trust to help you understand and take the next step can be daunting. The Expert Hub makes this easier.</p>
            <p style="font-family:Lato;font-size:21px;color:#2a2a2a;margin:0 0 22px;">The Expert Hub gives us:</p>
            <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 40px;font-family:Lato;font-size:20px;color:#2a2a2a;">
              <span>&bull;&nbsp; A clear starting point, with trusted experts and support.</span>
              <span>&bull;&nbsp; Small, meaningful steps you can take now.</span>
              <span>&bull;&nbsp; The confidence to know where to turn next when you&rsquo;re ready.</span>
            </div>
          </div>
        </div>
      </section>

      {/* Damien, 1 Aug 2026: "Need to be equal width […] the same 'imaginary'
          outer shape with equal space down the middle", and "Expert Hub has
          60/40 split in width? See pdf for reference."

          Both come off the same measurement. "Vilij Website Expert Hub page
          v2.pdf" puts every card inside an 800px shape on a 1920 artboard —
          left 111->911, right 1019->1819, gutter 108 — and nothing on the page
          escapes its shape. At this container that is 536 / 72 / 536, hence the
          72px column gap below and .vbleed-r on the cards: see cards.css.

          The photo sizes below are that PDF's, read off the clip path that
          masks each image rather than its placement box, which is a good deal
          smaller. As a share of the 800 shape, by grid position:

              R1 L 42.8%  0.79      R1 R 39.9%  0.75
              R2 L 36.4%  0.69      R2 R 55.9%  1.61
              R3 L 41.6%  0.92      R3 R 47.4%  0.87

          flex-basis resolves against the flex container's CONTENT box, not the
          card: 536 shape - 22 inset - 34 padding = 480. So each figure above is
          restated against 480, not 536 and not 514. Get that wrong and every
          photo comes out about 2.5 points narrow, which is small enough to look
          intentional and wrong enough to miss.

          The ratios replace the old fixed heights and align-self:stretch —
          "some are portrait some are square and some possibly landscape".
          Where the <img> is the flex item itself rather than sitting in a
          wrapper it also needs height:auto, or the intrinsic height attribute
          added in 21bdc83 wins and aspect-ratio never gets a say. Same trap as
          commit 23fe4b1.

          Photo side is left as built rather than taken from the PDF: the v2
          layout puts R1 R and R2 L on the left, but Damien has reviewed these
          cards twice without raising sides, so only the sizes move. */}
      <!-- ===== EXPERT HUB FEATURE CARDS ===== -->
      <section style="background:#ffffff;padding:58px 0 80px;">
        <div class="vwrap vcards2" style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1fr 1fr;gap:60px 72px;">

          <!-- Health & Therapy (orange, photo left) -->
          <div class="vcard-feat vsplit vbleed-l" style="position:relative;background:#f28121;border-radius:22px;display:flex;align-items:center;gap:26px;padding:32px 34px 32px 0;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 47.8%;margin-left:-22px;aspect-ratio:0.79;display:flex;">
              <img src="/assets/p_eh_health.png" alt="A therapy conversation" width="420" height="420" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Health<br />&amp; Therapy</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">When something feels off, but hard to explain.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support that helps things make a little more sense.</p>
            </div>
          </div>

          {/* Damien, 31 Jul 2026: "On the Expert Hub, the cards do need looking
              at please — same way as the others have just been done. Emotional &
              Fam / Featured Expert / Life, Work.. / Education & dev."

              Those four are the mirrored Sip & Natter shape, exactly as used on
              /cafe: photo down the right edge at full card height, text left.
              flex-direction:row-reverse with the DOM order left as photo-then-
              text is what lets responsive.css handle the mobile stack untouched
              — it forces .vsplit to `column` below 600px, which overrides the
              reverse.

              Health & Therapy already had the left-hand version of this shape.
              Legal, Financial & Future is left alone: Damien did not list it,
              and at 280px its photo is not one of the "floaty small" ones.

              The two flip cards lose .vcard-flip in the process. That class only
              exists to pull a heading back above the photo when the desktop
              shape puts it underneath; this shape does not, so all four now read
              title, strapline, body like the rest of the page.

              1 Aug: "full card height" is no longer true of any of them — the
              photos are on the PDF's aspect ratios now and sit centred. */}
          <!-- Emotional & Family Support (teal, photo right) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 44.6%;margin-right:-22px;aspect-ratio:0.75;display:flex;">
              <img src="/assets/p_eh_emotional.png" alt="A parent taking a moment" width="420" height="420" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Emotional<br />&amp; Family Support</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Because this affects all of you.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support for the weight you&rsquo;re carrying, every day.</p>
            </div>
          </div>

          <!-- Legal, Financial & Future (teal, photo right) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;align-items:center;gap:22px;padding:32px 0 32px 34px;min-height:330px;">
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Legal, Financial<br />&amp; Future</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Here when the big worries start to build.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Guidance to help you feel a little more in control.</p>
            </div>
            <img src="/assets/p_eh_legal.png" alt="Planning for the future together" width="420" height="420" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 40.6%;aspect-ratio:0.69;height:auto;object-fit:cover;margin-right:-22px;border-radius:14px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
          </div>

          {/* Damien: "this one also needs the title the right size". It was the
              only card heading on the page at 30px; every other one is 40px. Now
              40px like the rest. Note responsive.css steps type by matching the
              literal font-size string, so this heading now follows the 40px ramp
              (36px at <=1180, 24px at <=600, 22px at <=400) instead of the 30px
              one — which is the correct ramp for it to be on. */}
          {/* The one wide photo on the page: v2 has it at 55.9% of the shape
              and 1.61 landscape, against 36-47% and portrait-to-square for the
              other five. Deliberate in the design, so kept. */}
          <!-- Education & Development (orange, photo right) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#f28121;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 62.4%;margin-right:-22px;aspect-ratio:1.61;display:flex;">
              <img src="/assets/p_eh_education.png" alt="Learning resources in a classroom" width="420" height="420" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Education<br />&amp; Development</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">When school or learning feels hard.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support to help you understand and move forward.</p>
            </div>
          </div>

          <!-- Life, Work & Independence (orange, photo right) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#f28121;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 46.5%;margin-right:-22px;aspect-ratio:0.92;display:flex;">
              <img src="/assets/p_eh_life.png" alt="A family looking ahead" width="420" height="420" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Life, Work<br />&amp; Independence</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">For what comes next.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support to help build confidence and a way forward.</p>
            </div>
          </div>

          <!-- Featured Expert (teal, photo right) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 52.9%;margin-right:-22px;aspect-ratio:0.87;display:flex;">
              <img src="/assets/p_eh_expert.png" alt="A Vilij expert in conversation" width="420" height="420" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Featured<br />Expert</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Support you might not think to look for.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Shared in a way that feels real and easy to take in.</p>
            </div>
          </div>

        </div>
      </section>

      <!-- ===== BE MORE BAR ===== -->
      <div style="background:#2bbfba;">
        <div class="vwrap vbar" style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== WHAT ELSE INSIDE THE VILIJ ===== -->
      <AreasGrid items={gridItems} />

      <!-- ===== APP SIGNUP ORANGE BAND ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:62px 24px;">
        <p style="font-family:Lato;font-size:20px;color:#ffffff;margin:0 0 8px;">So what do I do next?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 14px;">Sign up to The Vilij App.</h2>
        <p style="font-family:Lato;font-size:22px;color:#fff;margin:0 0 34px;">Everything SEND in one place for just {monthlyPrice} per month.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#1f9ca0;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">JOIN US NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== STILL NOT SURE TEAL BAND ===== -->
      <section class="vband-sm" style="background:#1f9ca0;padding:30px 24px;">
        <div style="display:flex;align-items:center;justify-content:center;gap:34px;flex-wrap:wrap;">
          <span style="font-family:Lato;font-weight:400;font-size:34px;color:#d7f0f0;">Still not sure?</span>
          <a href="#" class="vpill" style="display:inline-flex;align-items:center;gap:14px;background:#f28121;color:#fff;font-family:Lato;font-weight:700;font-size:18px;letter-spacing:.5px;padding:12px 14px 12px 30px;border-radius:32px;text-decoration:none;box-shadow:0 8px 20px rgba(0,0,0,0.15);">TAKE A SNEAKY PEEK <span style="width:38px;height:38px;border-radius:50%;background:#ffffff;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:10px solid #1f9ca0;border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:3px;"></span></span></a>
        </div>
      </section>

      <!-- ===== TESTIMONIALS ===== -->
      <TestimonialCarousel list={testimonials} />

      <!-- ===== FINAL CTA ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:66px 24px;">
        <p style="font-family:Lato;font-size:22px;color:#ffffff;margin:0 0 10px;">So, you&rsquo;ve come this far?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 22px;">Your village is waiting for you.</h2>
        <p style="font-family:Lato;font-weight:700;font-size:24px;line-height:1.5;color:#fff;margin:0 0 36px;">You don&rsquo;t need to be at breaking point.<br />You don&rsquo;t need to have it all together.<br />You&rsquo;re allowed support too.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#f28121;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">SIGN UP NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter />

    </div>
</BaseLayout>
