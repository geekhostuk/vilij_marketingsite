---
// The Vilij — Vilij Expert Hub page
// Built from design "Vilij Website Expert Hub page v2.pdf"
const monthlyPrice = "£10";
const showSecondTestimonial = true;

const testimonials = [
  {
    quote:
      "As a parent of a 22-year-old son with autism, I finally feel understood. The Vilij offers practical support, genuine connection and reminds us we’re never alone.",
    name: "Emily & Loui",
    role: "SEND family, Newcastle-under-Lyme",
    stars: 5,
    photo: "/assets/p_emily_loui.png",
  },
  {
    quote:
      "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat wisi enim ad minim veniam.",
    name: "Margaret & Charlie",
    role: "SEND Family, Leeds",
    // Placeholder slot — no real quote, so no rating to show.
    stars: null,
    photo: "/assets/p_grand.png",
  },
];

const list = showSecondTestimonial ? testimonials : [testimonials[0]];
const first = list[0];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <title>Expert Hub — SEND Advice on Education and Health | The Vilij</title>
    <meta name="description" content="The Vilij Expert Hub connects SEND families with trusted professionals for guidance on education, health, legal questions, emotional support and daily life." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Mulish:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard { transition: transform .25s ease, box-shadow .25s ease; }
      .vcard-img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vcard:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(40,80,90,0.16) !important; }
      .vnav-cta:hover { background: #15838a !important; }
    </style>
  </head>
  <body>
    <div style="font-family:Mulish,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <nav style="display:flex;align-items:center;justify-content:space-between;">
            <a href="/"><img src="/assets/logo.png" alt="The Vilij" style="height:62px;width:auto;display:block;" /></a>
            <div style="display:flex;align-items:center;gap:42px;">
              <a href="/" class="vlink" style="font-family:Quicksand;font-weight:700;font-size:18px;color:#1f9ca0;text-decoration:none;">Home</a>
              <a href="#" class="vlink" style="font-family:Quicksand;font-weight:600;font-size:18px;color:#1f9ca0;text-decoration:none;">Explore The Vilij</a>
              <a href="#" class="vlink" style="font-family:Quicksand;font-weight:600;font-size:18px;color:#1f9ca0;text-decoration:none;">About Us</a>
              <a href="#" class="vnav-cta vpill" style="font-family:Quicksand;font-weight:700;font-size:16px;letter-spacing:.5px;color:#ffffff;background:#1f9ca0;padding:13px 30px;border-radius:30px;text-decoration:none;box-shadow:0 6px 16px rgba(31,156,160,0.3);">SIGN UP</a>
            </div>
          </nav>
          <div style="display:grid;grid-template-columns:1fr 1.05fr;gap:30px;align-items:center;padding:54px 0 70px;">
            <div>
              <h1 style="font-family:Quicksand;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Welcome to<br />the Expert Hub</h1>
              <p style="font-family:Mulish;font-weight:800;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:520px;">Trusted experts, tailored advice, and tools that make a difference.</p>
              <p style="font-family:Mulish;font-size:19px;line-height:1.55;color:#444;margin:0;max-width:520px;">This is a place to pause, breathe, and feel understood. It&rsquo;s a calmer way to find the right support, without needing all the answers first.</p>
            </div>
            <div style="display:flex;justify-content:center;">
              <div style="width:100%;max-width:600px;border-radius:26px;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);padding:26px 24px;box-shadow:0 16px 38px rgba(40,80,90,0.12);">
                <img src="/assets/experthub_hero.png" alt="The Vilij Expert Hub" style="width:100%;display:block;" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== RIGHT PLACE BAND ===== -->
      <div style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Quicksand;font-weight:500;font-size:36px;color:#ffe9d6;margin:0;">When things feel hard and you&rsquo;re not sure where to start, you&rsquo;re in the right place.</p>
      </div>

      <!-- ===== WHY THE EXPERT HUB EXISTS ===== -->
      <section style="background:#ffffff;padding:90px 0 30px;">
        <div style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div style="border-radius:26px;background:linear-gradient(90deg,#f6c79a 0%,#fbe5d1 26%,#ffffff 50%,#cfeae8 74%,#a4dbd7 100%);padding:50px 40px 56px;text-align:center;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <h2 style="font-family:Quicksand;font-weight:700;font-size:50px;color:#1f9ca0;margin:0 0 26px;">Why The Expert Hub Exists</h2>
            <p style="font-family:Mulish;font-weight:800;font-size:23px;line-height:1.5;color:#222;margin:0 auto 28px;max-width:820px;">Knowing who to trust to help you understand and take the next step can be daunting. The Expert Hub makes this easier.</p>
            <p style="font-family:Mulish;font-size:21px;color:#2a2a2a;margin:0 0 22px;">The Expert Hub gives us:</p>
            <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 40px;font-family:Mulish;font-size:20px;color:#2a2a2a;">
              <span>&bull;&nbsp; A clear starting point, with trusted experts and support.</span>
              <span>&bull;&nbsp; Small, meaningful steps you can take now.</span>
              <span>&bull;&nbsp; The confidence to know where to turn next when you&rsquo;re ready.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== EXPERT HUB FEATURE CARDS ===== -->
      <section style="background:#ffffff;padding:58px 0 80px;">
        <div style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1fr 1fr;gap:60px 44px;">

          <!-- Health & Therapy (orange, photo left) -->
          <div style="position:relative;background:#f28121;border-radius:22px;display:flex;align-items:center;gap:26px;padding:32px 34px 32px 0;min-height:330px;">
            <div style="flex:0 0 43%;min-width:0;margin-left:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_eh_health.png" alt="A therapy conversation" style="width:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;min-width:0;">
              <h3 style="font-family:Quicksand;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Health<br />&amp; Therapy</h3>
              <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0 0 12px;">When something feels off, but hard to explain.</p>
              <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support that helps things make a little more sense.</p>
            </div>
          </div>

          <!-- Emotional & Family Support (teal, photo top-right) -->
          <div style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Emotional<br />&amp; Family Support</h3>
                <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0;">Because this affects all of you.</p>
              </div>
              <img src="/assets/p_eh_emotional.png" alt="A parent taking a moment" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">Support for the weight you&rsquo;re carrying, every day.</p>
          </div>

          <!-- Legal, Financial & Future (teal, photo right) -->
          <div style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;align-items:center;gap:22px;padding:32px 0 32px 34px;min-height:330px;">
            <div style="flex:1;min-width:0;">
              <h3 style="font-family:Quicksand;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Legal, Financial<br />&amp; Future</h3>
              <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0 0 12px;">Here when the big worries start to build.</p>
              <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Guidance to help you feel a little more in control.</p>
            </div>
            <img src="/assets/p_eh_legal.png" alt="Planning for the future together" style="flex:0 0 42%;min-width:0;height:280px;object-fit:cover;margin-right:-22px;border-radius:14px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
          </div>

          <!-- Education & Development (orange, photo top-right) -->
          <div style="position:relative;background:#f28121;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:36px;color:#fff;margin:0 0 12px;line-height:1.02;">Education<br />&amp; Development</h3>
                <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0;">When school or learning feels hard.</p>
              </div>
              <img src="/assets/p_eh_education.png" alt="Learning resources in a classroom" style="flex:0 0 34%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">Support to help you understand and move forward.</p>
          </div>

          <!-- Life, Work & Independence (orange, body top, heading last) -->
          <div style="position:relative;background:#f28121;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0 0 12px;">For what comes next.</p>
                <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Support to help build confidence and a way forward.</p>
              </div>
              <img src="/assets/p_eh_life.png" alt="A family looking ahead" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <h3 style="font-family:Quicksand;font-weight:700;font-size:40px;color:#fff;margin:22px 0 0;line-height:1.02;">Life, Work<br />&amp; Independence</h3>
          </div>

          <!-- Featured Expert (teal, body top, heading last) -->
          <div style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <p style="font-family:Mulish;font-weight:800;font-size:20px;color:#fff;margin:0 0 12px;">Support you might not think to look for.</p>
                <p style="font-family:Mulish;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Shared in a way that feels real and easy to take in.</p>
              </div>
              <img src="/assets/p_eh_expert.png" alt="A Vilij expert in conversation" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <h3 style="font-family:Quicksand;font-weight:700;font-size:40px;color:#fff;margin:22px 0 0;line-height:1.02;">Featured<br />Expert</h3>
          </div>

        </div>
      </section>

      <!-- ===== BE MORE BAR ===== -->
      <div style="background:#2bbfba;">
        <div style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Quicksand;font-weight:600;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Quicksand;font-weight:600;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Quicksand;font-weight:600;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== WHAT ELSE INSIDE THE VILIJ ===== -->
      <section style="background:#ffffff;padding:84px 0 90px;">
        <div style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <h2 style="font-family:Quicksand;font-weight:700;font-size:44px;color:#1f9ca0;text-align:center;margin:0 0 14px;">What else you can see inside the Vilij</h2>
          <p style="font-family:Mulish;font-size:20px;color:#444;text-align:center;margin:0 0 54px;">Take a look at the other areas of The Vilij and find out why it&rsquo;s such a special place for SEND families.</p>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;">

            <!-- Vilij Hall -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/hall.png" alt="Vilij Hall" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">VILIJ HALL</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Where stories are shared, voices are heard, and support comes to life.</p>
                <a href="/hall" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S ON IN THE VILIJ HALL?</a>
              </div>
            </div>

            <!-- Beach photo -->
            <div style="border-radius:18px;overflow:hidden;box-shadow:0 10px 28px rgba(40,80,90,0.12);align-self:start;">
              <img src="/assets/p_beach.png" alt="Child at the beach" style="width:100%;height:auto;display:block;" />
            </div>

            <!-- Café -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/cafe.png" alt="Café" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">CAF&Eacute;</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Pull up a chair, pour a brew and find your people.</p>
                <a href="/cafe" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S ON AT THE CAF&Eacute;?</a>
              </div>
            </div>

            <!-- Library -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/library.png" alt="Library" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">LIBRARY</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Practical resources at your fingertips, ready whenever you are.</p>
                <a href="/library" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S IN THE LIBRARY?</a>
              </div>
            </div>

            <!-- Market Place -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/market.png" alt="Market Place" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">MARKET PLACE</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Discover wonderful products created by SEND parents in business.</p>
                <a href="#" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S ON AT THE MARKET PLACE?</a>
              </div>
            </div>

            <!-- High Street -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/highstreet.png" alt="High Street" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">HIGH STREET</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Handpicked products for SEND families, all in one easy place.</p>
                <a href="#" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S ON THE HIGH STREET?</a>
              </div>
            </div>

            <!-- Wellbeing -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/wellbeing.png" alt="Wellbeing Centre" class="vcard-img" /></div>
              <div style="padding:6px 30px 30px;display:flex;flex-direction:column;flex:1;">
                <h3 style="font-family:Quicksand;font-weight:700;font-size:25px;color:#1f9ca0;margin:0 0 10px;letter-spacing:.4px;">WELLBEING CENTRE</h3>
                <p style="font-family:Mulish;font-size:18px;line-height:1.5;color:#3a3a3a;margin:0 0 22px;flex:1;">Because caring for them starts with caring for you.</p>
                <a href="/wellbeing" class="vpill" style="align-self:flex-start;font-family:Mulish;font-weight:700;font-size:14px;letter-spacing:.4px;color:#fff;background:#f28121;padding:12px 24px;border-radius:26px;text-decoration:none;box-shadow:0 6px 14px rgba(242,129,33,0.3);">WHAT&rsquo;S ON AT THE WELLBEING CENTRE?</a>
              </div>
            </div>

            <!-- Family photo -->
            <div style="border-radius:18px;overflow:hidden;box-shadow:0 10px 28px rgba(40,80,90,0.12);align-self:start;">
              <img src="/assets/p_jose.png" alt="A SEND family" style="width:100%;height:auto;display:block;" />
            </div>

            <!-- Vilij Campus -->
            <div class="vcard" style="border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#fde7d0 0%,#f3e6d9 46%,#dcebe9 72%,#d3edee 100%);box-shadow:0 10px 28px rgba(40,80,90,0.09);display:flex;flex-direction:column;">
              <div style="padding:14px 8px 0;"><img src="/assets/campus.png" alt="Vilij Campus" class="vcard-img" /></div>
