---
// The Vilij — Café page
// Imported from Claude Design project "Webpage creation request" (Vilij Café.dc.html)
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AreasGrid from "../components/AreasGrid.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import { showSecondTestimonial } from "../data/testimonials";
import * as areas from "../data/areas";

const monthlyPrice = "£10";

const testimonials = [
  {
    quote:
      "As a parent of a 22-year-old son with autism, I finally feel understood. The Vilij offers practical support, genuine connection and reminds us we’re never alone.",
    name: "Emily & Loui",
    role: "SEND family, Newcastle-under-Lyme",
    stars: 5,
    photo: "/assets/p_emily_loui.png",
  },
  {
    quote:
      "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat wisi enim ad minim veniam.",
    name: "Margaret & Charlie",
    role: "SEND Family, Leeds",
    // Placeholder slot — no real quote, so no rating to show.
    stars: null,
    photo: "/assets/p_grand.jpg",
  },
];

const list = showSecondTestimonial ? testimonials : [testimonials[0]];

// The order of the "What else you can see inside the Vilij" grid, as it stands
// on this page. Every page uses a different order and a different second photo.
const gridItems = [
  areas.hall,
  { label: "Beach photo", img: "/assets/p_beach.jpg", alt: "Child at the beach" },
  areas.expertHub,
  areas.wellbeing,
  areas.marketPlace,
  areas.library,
  areas.highStreet,
  { label: "Grandparent photo", img: "/assets/p_grand.jpg", alt: "Grandparent and child", objectPosition: "32% center" },
  areas.campus,
];
---

<BaseLayout
  title="The Café — SEND Peer Support and Friendship | The Vilij"
  description="The Café is the space in The Vilij for everyday conversation between SEND families: informal chat, shared experience, peer support and real friendships."
  carousel={list}
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard { transition: transform .25s ease, box-shadow .25s ease; }
      .vcard-img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vcard:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(40,80,90,0.16) !important; }
      .vnav-cta:hover { background: #15838a !important; }
      /* The ISSUES #29 min-width:0 unlock that used to live here moved to
         cards.css on 1 Aug 2026, where it covers all five card pages instead of
         this one. Nothing else about this page's cards has changed — Damien:
         "the Cafe as you've done it up to yet works well". */
    </style><div style="font-family:Lato,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <SiteNav />
          <div class="vhero" style="display:grid;grid-template-columns:1fr 1.05fr;gap:30px;align-items:center;padding:60px 0 80px;">
            <div>
              <h1 style="font-family:Lato;font-weight:700;font-size:74px;line-height:1.02;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Welcome to the Caf&eacute;</h1>
              <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:520px;">Pull up a chair, pour a brew, and find your people.</p>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0;max-width:520px;">The Caf&eacute; includes several welcoming spaces, each designed for a different type of conversation.</p>
            </div>
            <div class="vhero-art" style="display:flex;justify-content:center;">
              <img src="/assets/cafe_hero.png" alt="The Café" width="1400" height="1045" fetchpriority="high" decoding="async" style="width:100%;max-width:600px;height:auto;display:block;" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== STAY AS LONG BAND ===== -->
      <div class="vband-sm" style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Lato;font-weight:400;font-size:36px;color:#ffffff;margin:0;">Stay as long as you like, the doors are always open.</p>
      </div>

      <!-- ===== WHY THE CAFÉ EXISTS ===== -->
      <section style="background:#ffffff;padding:90px 0 30px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div class="vpanel-soft" style="border-radius:26px;background:linear-gradient(100deg,#fcdcc0 0%,#fbe7d6 30%,#f4f1ec 50%,#dceae9 70%,#cfe9ea 100%);padding:48px 40px 54px;text-align:center;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#1f9ca0;margin:0 0 22px;">Why The Caf&eacute; Exists</h2>
            <p style="font-family:Lato;font-weight:700;font-size:21px;line-height:1.5;color:#353535;margin:0 auto 26px;max-width:920px;">The Caf&eacute; is a warm, heartfelt haven within The Vilij where SEND families who often feel isolated can breathe out, feel understood, and finally connect with others who truly get it.</p>
            <p style="font-family:Lato;font-size:19px;color:#3a3a3a;margin:0 0 18px;">The Caf&eacute; gives us:</p>
            <div style="display:flex;flex-direction:column;gap:10px;align-items:center;font-family:Lato;font-size:15px;color:#3a3a3a;">
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:20px;">
                <span>&bull;&nbsp; A friendly place for informal conversation.</span>
                <span>&bull;&nbsp; A space to share everyday experiences.</span>
                <span>&bull;&nbsp; Peer support without judgement.</span>
              </div>
              <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:20px;">
                <span>&bull;&nbsp; Moments of humour, relief, and solidarity.</span>
                <span>&bull;&nbsp; Opportunities to build genuine friendships.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Damien, 1 Aug 2026: "If this can't be achieved then the Cafe as
          you've done it up to yet works well." So the card compositions here
          are untouched — only the geometry underneath them, so that all five
          pages sit on the same grid.

          Two changes. The column gap goes 44px -> 72px, which is the 108px
          gutter in "Vilij Website Cafe page v 3.pdf" scaled to this container.
          And the four cards whose photo carries a -22px bleed pick up
          .vbleed-l / .vbleed-r, which insets the block by the same 22px so the
          photo lands ON the grid track edge instead of 22px past it — the
          asymmetry Damien spotted on the other three pages. Tea and Empathy and
          The Brew Source need neither: their photos are -20px inside 34px of
          padding, so they were already inside the track. That is why this page
          reads straight and /expert-hub does not.

          Note this page is built from Cafe v1; the source folder now holds v3,
          whose card compositions differ. Flagged to Damien rather than acted
          on. */}
      <!-- ===== CAFÉ FEATURE CARDS ===== -->
      <section style="background:#ffffff;padding:60px 0 80px;">
        <div class="vwrap vcards2" style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1fr 1fr;gap:46px 72px;">

          <!-- Sip & Natter (orange, photo left) -->
          <div class="vcard-feat vsplit vbleed-l" style="position:relative;background:#f28121;border-radius:22px;display:flex;align-items:center;gap:26px;padding:32px 34px 32px 0;min-height:300px;">
            <div class="vsplit-img" style="flex:0 0 43%;margin-left:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_sip.jpg" alt="Coffee chat" width="500" height="640" loading="lazy" decoding="async" style="width:100%;height:100%;min-width:0;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1;">Sip &amp; Natter</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Our friendship corner to exhale &amp; connect.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">It&rsquo;s a relaxed space for everyday chat, a place to catch up, share the little moments, laugh, vent, or just talk. The goal is simple: human connection.</p>
            </div>
          </div>

          <!-- Tea and Empathy (teal, photo top-right) -->
          <div class="vcard-feat" style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:300px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;">
                <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Tea and Empathy</h3>
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0;">Honest conversations without judgement.</p>
              </div>
              <img src="/assets/p_tea.jpg" alt="Tea and empathy" width="480" height="400" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">It&rsquo;s a quiet space for honest conversations about loneliness, exhaustion, identity, and the juggle of SEND family life, a place to feel understood and find hope in others who share similar experiences.</p>
          </div>

          <!-- The Brew Source (teal, photo top-right) -->
          <div class="vcard-feat" style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:300px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;">
                <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">The Brew Source</h3>
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0;">Quick answers from people who understand.</p>
              </div>
              <img src="/assets/p_brew.png" alt="Parents talking" width="800" height="444" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 42%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">It&rsquo;s a supportive space where parents share heartfelt advice, honest questions, and practical solutions, all easy to find or add when you need a little help.</p>
          </div>

          {/* Damien, 31 Jul 2026: "some of the images are small in the cards,
              need them to be bigger — good example Sip & Natter (can repeat
              similar on opposite side for Elder brew and brewful bites)... No
              floaty small images unless they need to be."

              So this is the Sip & Natter shape mirrored: same markup, same
              classes, plus flex-direction:row-reverse and the asymmetric padding
              flipped to the other edge. DOM order stays photo-then-text exactly
              as Sip & Natter has it, which is what makes the mobile layer work
              untouched — responsive.css forces .vsplit to `column` below 600px,
              which overrides row-reverse, so this stacks photo-above-text like
              every other card without a single new rule.

              It also drops .vcard-flip. That class exists to pull a heading back
              above the photo when the desktop shape puts it underneath; this
              shape does not, so the reordering is no longer needed. */}
          <!-- The Elder Brew (orange, photo right, full height) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#f28121;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:300px;">
            <div class="vsplit-img" style="flex:0 0 43%;margin-right:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_elder.jpg" alt="Grandparent and child" width="480" height="400" loading="lazy" decoding="async" style="width:100%;height:100%;min-width:0;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1;">The Elder Brew</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">A circle just for grandparents</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">SEND grandparents carry fierce love and quiet worries of their own. The Elder Brew offers a gentle space to share, support one another, and celebrate the children they cherish.</p>
            </div>
          </div>

          <!-- Show Us Your Mug (orange, photo left) -->
          <div class="vcard-feat vsplit vbleed-l" style="position:relative;background:#f28121;border-radius:22px;display:flex;align-items:center;gap:26px;padding:32px 34px 32px 0;min-height:300px;">
            <div class="vsplit-img" style="flex:0 0 43%;margin-left:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_mug.jpg" alt="Favourite mug" width="500" height="640" loading="lazy" decoding="async" style="width:100%;height:100%;min-width:0;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1;">Show Us Your Mug</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">A warm welcome to new Vilij members.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Make a brew and say hello by sharing your favourite mug and a few words about yourself.</p>
            </div>
          </div>

          {/* Mirrored Sip & Natter shape — see the note on The Elder Brew. */}
          <!-- Brewtiful Bites (teal, photo right, full height) -->
          <div class="vcard-feat vsplit vbleed-r" style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;flex-direction:row-reverse;align-items:center;gap:26px;padding:32px 0 32px 34px;min-height:300px;">
            <div class="vsplit-img" style="flex:0 0 43%;margin-right:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_bites.jpg" alt="Child enjoying food" width="480" height="400" loading="lazy" decoding="async" style="width:100%;height:100%;min-width:0;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1;">Brewtiful Bites</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Food, comfort, and small pleasures.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">A light-hearted space for sharing favourite recipes, comforting finds, quirky food combos, SEND-friendly places, and the little food joys that bring us together.</p>
            </div>
          </div>

        </div>
      </section>

      <!-- ===== BE MORE BAR ===== -->
      <div style="background:#2bbfba;">
        <div class="vwrap vbar" style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== WHAT ELSE INSIDE THE VILIJ ===== -->
      <AreasGrid items={gridItems} />

      <!-- ===== APP SIGNUP ORANGE BAND ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:62px 24px;">
        <p style="font-family:Lato;font-size:20px;color:#ffffff;margin:0 0 8px;">So what do I do next?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 14px;">Sign up to The Vilij App.</h2>
        <p style="font-family:Lato;font-size:22px;color:#fff;margin:0 0 34px;">Everything SEND in one place for just {monthlyPrice} per month.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#1f9ca0;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">JOIN US NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== STILL NOT SURE TEAL BAND ===== -->
      <section class="vband-sm" style="background:#1f9ca0;padding:30px 24px;">
        <div style="display:flex;align-items:center;justify-content:center;gap:34px;flex-wrap:wrap;">
          <span style="font-family:Lato;font-weight:400;font-size:34px;color:#d7f0f0;">Still not sure?</span>
          <a href="#" class="vpill" style="display:inline-flex;align-items:center;gap:14px;background:#f28121;color:#fff;font-family:Lato;font-weight:700;font-size:18px;letter-spacing:.5px;padding:12px 14px 12px 30px;border-radius:32px;text-decoration:none;box-shadow:0 8px 20px rgba(0,0,0,0.15);">TAKE A SNEAKY PEEK <span style="width:38px;height:38px;border-radius:50%;background:#ffffff;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:10px solid #1f9ca0;border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:3px;"></span></span></a>
        </div>
      </section>

      <!-- ===== TESTIMONIALS ===== -->
      <TestimonialCarousel list={list} showQuoteMark={false} />

      <!-- ===== FINAL CTA ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:66px 24px;">
        <p style="font-family:Lato;font-size:22px;color:#ffffff;margin:0 0 10px;">So, you&rsquo;ve come this far?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 22px;">Your village is waiting for you.</h2>
        <p style="font-family:Lato;font-weight:700;font-size:24px;line-height:1.5;color:#fff;margin:0 0 36px;">You don&rsquo;t need to be at breaking point.<br />You don&rsquo;t need to have it all together.<br />You&rsquo;re allowed support too.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#f28121;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">SIGN UP NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter />

    </div>
</BaseLayout>
