---
// The Vilij — Wellbeing Centre page
// Built from design "Vilij Website Wellbeing Centre page v2.pdf"
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AreasGrid from "../components/AreasGrid.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import { showSecondTestimonial } from "../data/testimonials";
import * as areas from "../data/areas";

const monthlyPrice = "£10";

const testimonials = [
  {
    quote:
      "As a parent of a 22-year-old son with autism, I finally feel understood. The Vilij offers practical support, genuine connection and reminds us we’re never alone.",
    name: "Emily & Loui",
    role: "SEND family, Newcastle-under-Lyme",
    stars: 5,
    photo: "/assets/p_emily_loui.png",
  },
  {
    quote:
      "Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat wisi enim ad minim veniam.",
    name: "Robert & Ethan",
    role: "SEND Grandparent, Bristol",
    // Placeholder slot — no real quote, so no rating to show.
    stars: null,
    photo: "/assets/p_grand.jpg",
  },
];

const list = showSecondTestimonial ? testimonials : [testimonials[0]];

// The order of the "What else you can see inside the Vilij" grid, as it stands
// on this page. Every page uses a different order and a different second photo.
const gridItems = [
  areas.hall,
  { label: "Beach photo", img: "/assets/p_beach.jpg", alt: "Child at the beach" },
  areas.expertHub,
  areas.cafe,
  areas.marketPlace,
  areas.library,
  areas.highStreet,
  { label: "Family photo", img: "/assets/p_grand.jpg", alt: "A SEND grandparent and child", objectPosition: "32% center" },
  areas.campus,
];
---

<BaseLayout
  title="Wellbeing Centre — Support for SEND Parent Carers | The Vilij"
  description="The Wellbeing Centre offers practical support for SEND parents and carers: ways to feel calmer, rest and reset, manage stress and keep going day to day."
  carousel={list}
  noindex
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vcard { transition: transform .25s ease, box-shadow .25s ease; }
      .vcard-img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
      .vcard:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(40,80,90,0.16) !important; }
      .vnav-cta:hover { background: #15838a !important; }
    </style><div style="font-family:Lato,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <SiteNav />
          <div class="vhero" style="display:grid;grid-template-columns:1fr 1.05fr;gap:30px;align-items:center;padding:54px 0 70px;">
            <div>
              <h1 style="font-family:Lato;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Welcome to the<br />Wellbeing Centre</h1>
              <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:520px;">Because caring for them starts with caring for you.</p>
              <p style="font-family:Lato;font-size:19px;line-height:1.55;color:#444;margin:0;max-width:520px;">Inside the Wellbeing Centre, you&rsquo;ll find different ways to support yourself, depending on what you need, how you feel, and how much energy you have.</p>
            </div>
            <div class="vhero-art" style="display:flex;justify-content:center;">
              <img src="/assets/wellbeing_hero.png" alt="The Vilij Wellbeing Centre" width="1400" height="874" fetchpriority="high" decoding="async" style="width:100%;max-width:600px;height:auto;display:block;" />
            </div>
          </div>
        </div>
      </section>

      <!-- ===== RUNNING ON EMPTY BAND ===== -->
      <div class="vband-sm" style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Lato;font-weight:400;font-size:36px;color:#ffffff;margin:0;">Because you can&rsquo;t keep going when you&rsquo;re running on empty.</p>
      </div>

      <!-- ===== WHY THE WELLBEING CENTRE EXISTS ===== -->
      <section style="background:#ffffff;padding:90px 0 30px;">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:0 48px;">
          <div class="vpanel-soft" style="border-radius:26px;background:linear-gradient(90deg,#f6c79a 0%,#fbe5d1 26%,#ffffff 50%,#cfeae8 74%,#a4dbd7 100%);padding:50px 40px 56px;text-align:center;box-shadow:0 14px 36px rgba(40,80,90,0.08);">
            <h2 style="font-family:Lato;font-weight:700;font-size:50px;color:#1f9ca0;margin:0 0 26px;">Why The Wellbeing Centre Exists</h2>
            <p style="font-family:Lato;font-weight:700;font-size:23px;line-height:1.5;color:#222;margin:0 auto 28px;max-width:820px;">The Wellbeing Centre is a place to steady yourself, regulate, and get through today.</p>
            <p style="font-family:Lato;font-size:21px;color:#2a2a2a;margin:0 0 22px;">The Wellbeing Centre gives us:</p>
            <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 40px;font-family:Lato;font-size:20px;color:#2a2a2a;">
              <span>&bull;&nbsp; Simple support that works in real life, even on your hardest days.</span>
              <span>&bull;&nbsp; Tools and space to feel calmer, more in control, and less alone.</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== WELLBEING FEATURE CARDS ===== -->
      <section style="background:#ffffff;padding:58px 0 80px;">
        <div class="vwrap vcards2" style="max-width:1240px;margin:0 auto;padding:0 48px;display:grid;grid-template-columns:1fr 1fr;gap:60px 44px;">

          <!-- Body-Based Calm (orange, photo left) -->
          <div class="vcard-feat vsplit" style="position:relative;background:#f28121;border-radius:22px;display:flex;align-items:center;gap:26px;padding:32px 34px 32px 0;min-height:330px;">
            <div class="vsplit-img" style="flex:0 0 43%;min-width:0;margin-left:-22px;align-self:stretch;display:flex;">
              <img src="/assets/p_wb_calm.jpg" alt="Someone stretching out on the floor at home" width="480" height="660" loading="lazy" decoding="async" style="width:100%;object-fit:cover;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <div style="flex:1;min-width:0;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Body-Based<br />Calm</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Calm your body when everything feels too much.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Find steadiness again, quickly and simply.</p>
            </div>
          </div>

          <!-- Improve Your Emotional Wellbeing (teal, photo top-right) -->
          <div class="vcard-feat" style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <h3 style="font-family:Lato;font-weight:700;font-size:30px;color:#fff;margin:0 0 12px;line-height:1.02;">Improve Your<br />Emotional Wellbeing</h3>
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0;">Understand what you&rsquo;re feeling without judgement.</p>
              </div>
              <img src="/assets/p_wb_emotional.jpg" alt="One person holding another&rsquo;s hands" width="460" height="400" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 34%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">Feel seen, supported, and less alone.</p>
          </div>

          <!-- Burnout Survival & Recovery (teal, photo right) -->
          <div class="vcard-feat vsplit" style="position:relative;background:#1f9ca0;border-radius:22px;display:flex;align-items:center;gap:22px;padding:32px 0 32px 34px;min-height:330px;">
            <div style="flex:1;min-width:0;">
              <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:0 0 12px;line-height:1.02;">Burnout Survival<br />&amp; Recovery</h3>
              <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Keep going without pushing yourself to breaking point.</p>
              <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Rest, reset, and rebuild your energy.</p>
            </div>
            <img src="/assets/p_wb_burnout.jpg" alt="A parent resting on the sofa with two children" width="470" height="570" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 42%;min-width:0;height:280px;object-fit:cover;margin-right:-22px;border-radius:14px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
          </div>

          <!-- Navigating Your Support Team (orange, photo top-right) -->
          <div class="vcard-feat" style="position:relative;background:#f28121;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <h3 style="font-family:Lato;font-weight:700;font-size:30px;color:#fff;margin:0 0 12px;line-height:1.02;">Navigating<br />Your Support Team</h3>
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0;">Make sense of the relationships around you.</p>
              </div>
              <img src="/assets/p_wb_team.jpg" alt="A support group sitting in a circle, hands joined" width="460" height="400" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 34%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:18px 0 0;">Feel clearer and less overwhelmed by others.</p>
          </div>

          <!-- Financial Peace of Mind (orange, body top, heading last) -->
          <div class="vcard-feat vcard-flip" style="position:relative;background:#f28121;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Reduce the stress that sits quietly in the background.</p>
                <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Feel more secure and able to breathe.</p>
              </div>
              <img src="/assets/p_wb_finance.jpg" alt="Someone lying on a hillside looking out at the view" width="460" height="400" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:22px 0 0;line-height:1.02;">Financial<br />Peace of Mind</h3>
          </div>

          <!-- Social Media - Friend or Foe? (teal, body top, heading last) -->
          <div class="vcard-feat vcard-flip" style="position:relative;background:#1f9ca0;border-radius:22px;padding:32px 34px;min-height:330px;">
            <div class="vsplit" style="display:flex;gap:18px;align-items:flex-start;">
              <div style="flex:1;min-width:0;">
                <p style="font-family:Lato;font-weight:700;font-size:22px;color:#fff;margin:0 0 12px;">Step away from pressure, comparison, and noise.</p>
                <p style="font-family:Lato;font-size:17px;line-height:1.5;color:rgba(255,255,255,0.95);margin:0;">Protect your peace and feel more in control.</p>
              </div>
              <img src="/assets/p_wb_social.jpg" alt="A phone screen showing a folder of social media apps" width="460" height="400" loading="lazy" decoding="async" class="vsplit-img" style="flex:0 0 40%;min-width:0;height:190px;object-fit:cover;margin-top:-26px;margin-right:-20px;border-radius:16px;box-shadow:0 14px 28px rgba(0,0,0,0.18);" />
            </div>
            <h3 style="font-family:Lato;font-weight:700;font-size:40px;color:#fff;margin:22px 0 0;line-height:1.02;">Social Media:<br />Friend or Foe?</h3>
          </div>

        </div>
      </section>

      <!-- ===== BE MORE BAR ===== -->
      <div style="background:#2bbfba;">
        <div class="vwrap vbar" style="max-width:1240px;margin:0 auto;padding:30px 48px;display:flex;justify-content:space-around;align-items:center;gap:20px;">
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be More</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Brave</span>
          <span style="font-family:Lato;font-weight:700;font-size:42px;color:#ffffff;">Be Curious</span>
        </div>
      </div>

      <!-- ===== WHAT ELSE INSIDE THE VILIJ ===== -->
      <AreasGrid items={gridItems} />

      <!-- ===== APP SIGNUP ORANGE BAND ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:62px 24px;">
        <p style="font-family:Lato;font-size:20px;color:#ffffff;margin:0 0 8px;">So what do I do next?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 14px;">Sign up to The Vilij App.</h2>
        <p style="font-family:Lato;font-size:22px;color:#fff;margin:0 0 34px;">Everything SEND in one place for just {monthlyPrice} per month.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#1f9ca0;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">JOIN US NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== STILL NOT SURE TEAL BAND ===== -->
      <section class="vband-sm" style="background:#1f9ca0;padding:30px 24px;">
        <div style="display:flex;align-items:center;justify-content:center;gap:34px;flex-wrap:wrap;">
          <span style="font-family:Lato;font-weight:400;font-size:34px;color:#d7f0f0;">Still not sure?</span>
          <a href="#" class="vpill" style="display:inline-flex;align-items:center;gap:14px;background:#f28121;color:#fff;font-family:Lato;font-weight:700;font-size:18px;letter-spacing:.5px;padding:12px 14px 12px 30px;border-radius:32px;text-decoration:none;box-shadow:0 8px 20px rgba(0,0,0,0.15);">TAKE A SNEAKY PEEK <span style="width:38px;height:38px;border-radius:50%;background:#ffffff;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:10px solid #1f9ca0;border-top:6px solid transparent;border-bottom:6px solid transparent;margin-left:3px;"></span></span></a>
        </div>
      </section>

      <!-- ===== TESTIMONIALS ===== -->
      <TestimonialCarousel list={list} />

      <!-- ===== FINAL CTA ===== -->
      <section class="vband" style="background:#f28121;text-align:center;padding:66px 24px;">
        <p style="font-family:Lato;font-size:22px;color:#ffffff;margin:0 0 10px;">So, you&rsquo;ve come this far?</p>
        <h2 style="font-family:Lato;font-weight:700;font-size:58px;color:#ffffff;margin:0 0 22px;">Your village is waiting for you.</h2>
        <p style="font-family:Lato;font-weight:700;font-size:24px;line-height:1.5;color:#fff;margin:0 0 36px;">You don&rsquo;t need to be at breaking point.<br />You don&rsquo;t need to have it all together.<br />You&rsquo;re allowed support too.</p>
        <a href="https://app.thevilij.co.uk" class="vpill" style="display:inline-flex;align-items:center;gap:16px;background:#ffffff;color:#f28121;font-family:Lato;font-weight:700;font-size:19px;letter-spacing:.5px;padding:14px 16px 14px 34px;border-radius:34px;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,0.12);">SIGN UP NOW <span style="width:40px;height:40px;border-radius:50%;background:#1f9ca0;display:inline-flex;align-items:center;justify-content:center;"><span style="width:0;height:0;border-left:11px solid #fff;border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px;"></span></span></a>
      </section>

      <!-- ===== FOOTER ===== -->
      <SiteFooter />

    </div>
</BaseLayout>
