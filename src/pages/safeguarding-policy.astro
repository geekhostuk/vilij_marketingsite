<BaseLayout
  title="Safeguarding Policy | The Vilij"
  description="How The Vilij protects children and adults at risk: recognising and reporting safeguarding concerns, online safety, moderation, record keeping and who to contact."
>
    <style is:global>
      body { margin: 0; }
      * { box-sizing: border-box; }
      .vlink:hover { color: #f28121 !important; }
      .vpill:hover { filter: brightness(1.05); }
      .vnav-cta:hover { background: #15838a !important; }
      .vclause { display: grid; grid-template-columns: 72px 1fr; gap: 0 12px; margin: 0 0 20px; }
      .vsub { display: grid; grid-template-columns: 44px 1fr; gap: 0 12px; margin: 12px 0 0; }
      .vtoc a:hover { color: #f28121 !important; }
      @media (max-width: 820px) {
        .vclause { grid-template-columns: 54px 1fr; }
        .vsub { grid-template-columns: 34px 1fr; }
      }
    </style><div style="font-family:Mulish,sans-serif;color:#353535;background:#ffffff;width:100%;overflow-x:hidden;">

      <!-- ===== HEADER + HERO ===== -->
      <section style="position:relative;background:linear-gradient(100deg,#dbeef1 0%,#e7eef0 38%,#f5e9dc 72%,#fbe1cd 100%);">
        <div class="vwrap" style="max-width:1240px;margin:0 auto;padding:30px 48px 0;">
          <SiteNav />
          <div class="vhero-text" style="padding:54px 0 70px;max-width:820px;">
            <h1 style="font-family:Quicksand;font-weight:700;font-size:74px;line-height:1.04;color:#1f9ca0;margin:0 0 30px;letter-spacing:-1px;">Safeguarding Policy</h1>
            <p style="font-family:Mulish;font-weight:800;font-size:23px;line-height:1.4;color:#353535;margin:0 0 22px;max-width:640px;">Keeping children and adults at risk safe is everyone&rsquo;s job.</p>
            <p style="font-family:Mulish;font-size:19px;line-height:1.55;color:#444;margin:0 0 30px;max-width:640px;">This policy sets out how The Vilij recognises, reports and responds to safeguarding concerns &mdash; what we expect of everyone in the community, and what we will do when something is raised.</p>
            <p style="font-family:Mulish;font-weight:700;font-size:16px;letter-spacing:.4px;color:#1f9ca0;margin:0;display:inline-block;background:rgba(255,255,255,0.6);border-radius:24px;padding:11px 22px;">Effective from <time datetime="2026-07-24">24 July 2026</time></p>
          </div>
        </div>
      </section>

      <!-- ===== BAND ===== -->
      <div class="vband-sm" style="background:#f28121;text-align:center;padding:26px 24px;">
        <p style="font-family:Quicksand;font-weight:500;font-size:36px;color:#ffe9d6;margin:0;">If someone is in immediate danger, call 999 first.</p>
      </div>

      <!-- ===== CONTENTS ===== -->
      <LegalContents sections={sections} heading={"What&rsquo;s In This Policy"} />

      <!-- ===== POLICY BODY ===== -->
      <LegalSections sections={sections} />

